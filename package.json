{
  "name": "abc-textbook",
  "version": "0.1.0",
  "private": true,
  "description": "ABC 212以降の上級問題を典型と前提関係で体系化する静的教材とローカル検証CLI",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25.0.0",
    "npm": ">=11.16.0 <12.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.18.0 <25.0.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0 <12.0.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.astro.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "schema:generate": "tsx scripts/generate-json-schemas.ts",
    "schema:check": "tsx scripts/generate-json-schemas.ts --check",
    "catalog:build": "tsx scripts/catalog-build.ts",
    "catalog:validate": "tsx scripts/catalog-validate.ts",
    "corpus:policy-fingerprints": "tsx scripts/corpus/policy-fingerprints.ts",
    "corpus:acquire-metadata": "tsx scripts/corpus/acquire-metadata.ts",
    "corpus:verify-metadata": "tsx scripts/corpus/verify-metadata.ts",
    "corpus:materialize-metadata": "tsx scripts/corpus/materialize-metadata.ts",
    "corpus:author-inventory": "tsx scripts/corpus/author-inventory.ts",
    "corpus:export-inventory-review-packets": "tsx scripts/corpus/export-inventory-review-packets.ts",
    "corpus:verify-authoring": "tsx scripts/corpus/verify-inventory-authoring.ts --check",
    "corpus:verify-authoring:write": "tsx scripts/corpus/verify-inventory-authoring.ts --write",
    "preview:candidate-template": "tsx scripts/corpus/candidate-template.ts",
    "preview:apply-candidate-classifications": "tsx scripts/corpus/apply-candidate-classifications.ts",
    "preview:build-candidate-pool": "tsx scripts/corpus/build-candidate-pool.ts",
    "preview:freeze-cohort": "tsx scripts/corpus/freeze-cohort.ts",
    "preview:taxonomy": "tsx scripts/corpus/freeze-provisional-taxonomy.ts --check",
    "preview:taxonomy:write": "tsx scripts/corpus/freeze-provisional-taxonomy.ts --write",
    "preview:learning-content": "tsx scripts/corpus/freeze-preview-learning-content.ts --check",
    "preview:learning-content:write": "tsx scripts/corpus/freeze-preview-learning-content.ts --write",
    "preview:verify": "tsx scripts/preview-verify.ts",
    "corpus:verify": "tsx scripts/corpus/verify-inventory.ts --check",
    "corpus:verify:write": "tsx scripts/corpus/verify-inventory.ts --write",
    "test:e2e": "npm run build && npm run test:e2e:built --",
    "test:e2e:built": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:install:ci": "playwright install --with-deps chromium firefox webkit",
    "link:check": "npm run build && npm run link:check:built",
    "link:check:built": "tsx scripts/validate/links.ts",
    "verify:fast": "tsx scripts/verify/fast.ts",
    "verify:learning-records": "tsx scripts/verify-learning-records.ts",
    "abc:update": "tsx scripts/update-abc/index.ts",
    "release:bootstrap": "tsx scripts/update-abc/bootstrap.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "abc:review": "tsx scripts/review-update.ts"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@astrojs/starlight": "0.41.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.1.0",
    "cheerio": "1.2.0",
    "idb": "8.0.3",
    "pagefind": "1.5.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "10.1.0",
    "eslint": "10.7.0",
    "eslint-plugin-astro": "3.0.1",
    "globals": "17.7.0",
    "linkinator": "7.6.1",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
