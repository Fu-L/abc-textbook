{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-textbook.local/schemas/glossary.schema.json",
  "title": "ABC Textbook Canonical Glossary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "language", "terms", "digest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "language": { "const": "ja" },
    "terms": {
      "type": "array",
      "items": { "$ref": "#/$defs/term" }
    },
    "digest": {
      "$ref": "#/$defs/sha256",
      "description": "このJSON objectをkey順・array順・null表現までcanonical化し、自身のdigest fieldだけを除外して計算したSHA-256。"
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonicalName", "aliases", "definition", "prerequisiteTermIds", "firstUseUnitId", "scope", "sourceRevisionIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^term-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "canonicalName": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "definition": { "type": "string", "minLength": 1 },
        "prerequisiteTermIds": { "type": "array", "items": { "type": "string", "pattern": "^term-[a-z0-9]+(?:-[a-z0-9]+)*$" }, "uniqueItems": true },
        "firstUseUnitId": { "type": "string", "pattern": "^unit-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "scope": { "enum": ["global", "genre", "unit"] },
        "sourceRevisionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
