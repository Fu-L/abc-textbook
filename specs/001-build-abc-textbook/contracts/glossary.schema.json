{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "$ref": "#/$defs/__schema1"
    },
    "language": {
      "$ref": "#/$defs/__schema2"
    },
    "terms": {
      "$ref": "#/$defs/__schema3"
    },
    "digest": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "language",
    "terms",
    "digest"
  ],
  "additionalProperties": false,
  "$id": "https://abc-textbook.local/schemas/glossary.schema.json",
  "title": "ABC Textbook Glossary",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "__schema2": {
      "type": "string",
      "const": "ja"
    },
    "__schema3": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^term-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "canonicalName": {
            "$ref": "#/$defs/__schema4"
          },
          "aliases": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema4"
            },
            "uniqueItems": true
          },
          "definition": {
            "$ref": "#/$defs/__schema4"
          },
          "prerequisiteTermIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema5"
            },
            "uniqueItems": true
          },
          "firstUseUnitId": {
            "type": "string",
            "pattern": "^unit-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "scope": {
            "type": "string",
            "enum": [
              "global",
              "genre",
              "unit"
            ]
          },
          "sourceRevisionIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema4"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "canonicalName",
          "aliases",
          "definition",
          "prerequisiteTermIds",
          "firstUseUnitId",
          "scope",
          "sourceRevisionIds"
        ],
        "additionalProperties": false
      }
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "__schema5": {
      "type": "string",
      "pattern": "^term-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema6": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
