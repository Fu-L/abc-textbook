{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "releaseDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "inventoryDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "inventoryCount": {
      "$ref": "#/$defs/__schema2"
    },
    "checkedCount": {
      "$ref": "#/$defs/__schema3"
    },
    "passedCount": {
      "$ref": "#/$defs/__schema4"
    },
    "failedCount": {
      "$ref": "#/$defs/__schema5"
    },
    "aggregatePassed": {
      "$ref": "#/$defs/__schema6"
    },
    "items": {
      "$ref": "#/$defs/__schema7"
    },
    "generatedAt": {
      "$ref": "#/$defs/__schema21"
    }
  },
  "required": [
    "schemaVersion",
    "releaseDigest",
    "inventoryDigest",
    "inventoryCount",
    "checkedCount",
    "passedCount",
    "failedCount",
    "aggregatePassed",
    "items",
    "generatedAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "aggregatePassed": {
            "const": true
          }
        },
        "required": [
          "aggregatePassed"
        ]
      },
      "then": {
        "properties": {
          "failedCount": {
            "const": 0
          },
          "items": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "failedCount": {
            "minimum": 1
          }
        }
      }
    }
  ],
  "$id": "https://abc-textbook.local/schemas/answer-material-evidence.schema.json",
  "title": "ABC Textbook Answer Material Evidence",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "2.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema2": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema3": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "type": "boolean"
    },
    "__schema7": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "problemId": {
          "$ref": "#/$defs/__schema9"
        },
        "exerciseKey": {
          "$ref": "#/$defs/__schema10"
        },
        "contentDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "learningOutcomeIds": {
          "$ref": "#/$defs/__schema11"
        },
        "prerequisiteIds": {
          "$ref": "#/$defs/__schema13"
        },
        "attainmentCondition": {
          "$ref": "#/$defs/__schema14"
        },
        "sourceRefs": {
          "$ref": "#/$defs/__schema15"
        },
        "sourceVersion": {
          "$ref": "#/$defs/__schema14"
        },
        "method": {
          "$ref": "#/$defs/__schema16"
        },
        "automationDecision": {
          "$ref": "#/$defs/__schema17"
        },
        "automationRationale": {
          "$ref": "#/$defs/__schema18"
        },
        "procedure": {
          "$ref": "#/$defs/__schema14"
        },
        "command": {
          "$ref": "#/$defs/__schema19"
        },
        "exitCode": {
          "$ref": "#/$defs/__schema20"
        },
        "expectedResult": {
          "$ref": "#/$defs/__schema14"
        },
        "observedResult": {
          "$ref": "#/$defs/__schema14"
        },
        "verifiedAt": {
          "$ref": "#/$defs/__schema21"
        },
        "status": {
          "$ref": "#/$defs/__schema22"
        },
        "observedResultDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "evidencePath": {
          "$ref": "#/$defs/__schema23"
        },
        "evidenceDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "humanReviewEvidenceIds": {
          "$ref": "#/$defs/__schema24"
        }
      },
      "required": [
        "problemId",
        "exerciseKey",
        "contentDigest",
        "learningOutcomeIds",
        "prerequisiteIds",
        "attainmentCondition",
        "sourceRefs",
        "sourceVersion",
        "method",
        "automationDecision",
        "automationRationale",
        "procedure",
        "command",
        "exitCode",
        "expectedResult",
        "observedResult",
        "verifiedAt",
        "status",
        "observedResultDigest",
        "evidencePath",
        "evidenceDigest",
        "humanReviewEvidenceIds"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "automated"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "automationDecision": {
                "const": "automated"
              },
              "automationRationale": {
                "type": "null"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "exitCode": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "automationDecision": {
                "const": "not-practical"
              },
              "automationRationale": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "null"
              },
              "exitCode": {
                "type": "null"
              },
              "humanReviewEvidenceIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "automated"
              },
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "method",
              "status"
            ]
          },
          "then": {
            "properties": {
              "exitCode": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "__schema9": {
      "type": "string",
      "pattern": "^abc[0-9]{3,}-[a-z][a-z0-9+_-]*$"
    },
    "__schema10": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "__schema11": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      },
      "uniqueItems": true
    },
    "__schema12": {
      "type": "string",
      "pattern": "^outcome-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema13": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      },
      "uniqueItems": true
    },
    "__schema14": {
      "type": "string",
      "minLength": 1
    },
    "__schema15": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      },
      "uniqueItems": true
    },
    "__schema16": {
      "type": "string",
      "enum": [
        "automated",
        "documented-procedure",
        "human-review"
      ]
    },
    "__schema17": {
      "type": "string",
      "enum": [
        "automated",
        "not-practical"
      ]
    },
    "__schema18": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema14"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema19": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema14"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema20": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema21": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema22": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "__schema23": {
      "type": "string",
      "pattern": "^(?!.*(?:^|\\/)(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.[A-Za-z0-9._-]+)?(?:\\/|$))(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])(?:\\/[A-Za-z0-9._-]*[A-Za-z0-9_-])*$"
    },
    "__schema24": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      },
      "uniqueItems": true
    }
  }
}
