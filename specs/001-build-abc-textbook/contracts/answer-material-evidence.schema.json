{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-textbook.local/schemas/answer-material-evidence.schema.json",
  "title": "ABC Textbook Answer Material Verification Evidence",
  "description": "current ReleaseCandidate inventoryに対する一つのimmutable aggregate revision。各AnswerMaterial IDの最新contentをちょうど1 item含め、inventoryCount=checkedCount=items.length、passedCount/failedCountとstatus件数の一致を意味検証する。失敗aggregateとrawは上書きせず新revisionで再検証し、Release evidenceはcurrent inventoryに対する最新の合格aggregate digestだけを参照する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseDigest", "inventoryDigest", "inventoryCount", "checkedCount", "passedCount", "failedCount", "aggregatePassed", "items", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "releaseDigest": { "$ref": "#/$defs/sha256", "description": "対象Catalog Release.contentSnapshotDigestと完全一致する。Release.manifestDigest、candidateManifestDigest、candidatePayloadDigestを指定してはならない。" },
    "inventoryDigest": { "$ref": "#/$defs/sha256", "description": "current candidateのAnswerMaterial ID/contentDigestをID順に並べたcanonical inventory digest。" },
    "inventoryCount": { "type": "integer", "minimum": 1 },
    "checkedCount": { "type": "integer", "minimum": 1 },
    "passedCount": { "type": "integer", "minimum": 0 },
    "failedCount": { "type": "integer", "minimum": 0 },
    "aggregatePassed": { "type": "boolean" },
    "items": { "description": "current inventoryの各AnswerMaterial IDを最新content digestでちょうど一度含む。ID一意性とcount一致は意味検証器でも検査する。", "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/item" } },
    "generatedAt": { "$ref": "#/$defs/dateTime" }
  },
  "allOf": [
    {
      "if": { "properties": { "aggregatePassed": { "const": true } }, "required": ["aggregatePassed"] },
      "then": {
        "properties": {
          "passedCount": { "minimum": 1 },
          "failedCount": { "const": 0 },
          "items": { "items": { "properties": { "status": { "const": "passed" } } } }
        }
      }
    },
    {
      "if": { "properties": { "aggregatePassed": { "const": false } }, "required": ["aggregatePassed"] },
      "then": {
        "properties": {
          "failedCount": { "minimum": 1 },
          "items": {
            "contains": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "safeRelativePath": { "type": "string", "minLength": 1, "pattern": "^(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[A-Za-z0-9._-]+)?(?:/|$))(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])(?:/[A-Za-z0-9._-]*[A-Za-z0-9_-])*$", "description": "全target OSで同じbytesへ正規化できるrepository-relative canonical slash-only regular-file path。portable ASCII segmentだけを許し、absolute/drive/UNC、backslash、dot/dot-dot/空segment、trailing dot/slash、Windows禁止文字/device nameを拒否し、symlink解決後もrepository root内に限定する。" },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["answerMaterialId", "contentDigest", "learningOutcomeIds", "prerequisiteIds", "attainmentCondition", "sourceRefs", "sourceVersion", "method", "automationDecision", "automationRationale", "procedure", "command", "exitCode", "expectedResult", "observedResult", "verifiedAt", "status", "observedResultDigest", "evidencePath", "evidenceDigest", "humanReviewEvidenceIds"],
      "properties": {
        "answerMaterialId": { "type": "string", "pattern": "^answer-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "contentDigest": { "$ref": "#/$defs/sha256" },
        "learningOutcomeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^outcome-[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "prerequisiteIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "attainmentCondition": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "method": { "enum": ["automated", "documented-procedure", "human-review"] },
        "automationDecision": { "enum": ["automated", "not-practical"] },
        "automationRationale": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "procedure": { "type": "string", "minLength": 1 },
        "command": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "exitCode": { "oneOf": [{ "type": "integer" }, { "type": "null" }] },
        "expectedResult": { "type": "string", "minLength": 1 },
        "observedResult": { "type": "string", "minLength": 1 },
        "verifiedAt": { "$ref": "#/$defs/dateTime" }, "status": { "enum": ["passed", "failed"] },
        "observedResultDigest": { "$ref": "#/$defs/sha256" }, "evidencePath": { "$ref": "#/$defs/safeRelativePath" },
        "evidenceDigest": { "$ref": "#/$defs/sha256" },
        "humanReviewEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "automated" } }, "required": ["method"] },
          "then": { "properties": { "automationDecision": { "const": "automated" }, "automationRationale": { "type": "null" }, "command": { "type": "string", "minLength": 1 }, "exitCode": { "type": "integer" } } }
        },
        {
          "if": { "properties": { "method": { "enum": ["documented-procedure", "human-review"] } }, "required": ["method"] },
          "then": { "properties": { "automationDecision": { "const": "not-practical" }, "automationRationale": { "type": "string", "minLength": 1 }, "command": { "type": "null" }, "exitCode": { "type": "null" } } }
        },
        {
          "if": { "properties": { "method": { "const": "automated" }, "status": { "const": "passed" } }, "required": ["method", "status"] },
          "then": { "properties": { "exitCode": { "const": 0 } } }
        },
        {
          "if": { "properties": { "automationDecision": { "const": "not-practical" } }, "required": ["automationDecision"] },
          "then": { "properties": { "humanReviewEvidenceIds": { "minItems": 1 } } }
        }
      ]
    }
  }
}
