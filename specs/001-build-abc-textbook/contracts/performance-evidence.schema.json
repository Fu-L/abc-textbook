{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "releaseDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "environment": {
      "$ref": "#/$defs/__schema2"
    },
    "fixtures": {
      "$ref": "#/$defs/__schema4"
    },
    "buildRuns": {
      "$ref": "#/$defs/__schema14"
    },
    "filterMeasurement": {
      "$ref": "#/$defs/__schema16"
    },
    "successfulUpdateMeasurement": {
      "$ref": "#/$defs/__schema17"
    },
    "generatedAt": {
      "$ref": "#/$defs/__schema9"
    }
  },
  "required": [
    "schemaVersion",
    "releaseDigest",
    "environment",
    "fixtures",
    "buildRuns",
    "filterMeasurement",
    "successfulUpdateMeasurement",
    "generatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://abc-textbook.local/schemas/performance-evidence.schema.json",
  "title": "ABC Textbook Performance Evidence",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.1.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "os": {
          "$ref": "#/$defs/__schema3"
        },
        "cpu": {
          "$ref": "#/$defs/__schema3"
        },
        "physicalCores": {
          "type": "integer",
          "minimum": 4,
          "maximum": 9007199254740991
        },
        "memoryGiB": {
          "type": "number",
          "minimum": 16
        },
        "storage": {
          "type": "string",
          "const": "local-ssd"
        },
        "powerSource": {
          "type": "string",
          "const": "ac"
        },
        "concurrentHighLoad": {
          "type": "boolean",
          "const": false
        },
        "nodeVersion": {
          "$ref": "#/$defs/__schema3"
        },
        "npmVersion": {
          "$ref": "#/$defs/__schema3"
        },
        "chromiumRevision": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "os",
        "cpu",
        "physicalCores",
        "memoryGiB",
        "storage",
        "powerSource",
        "concurrentHighLoad",
        "nodeVersion",
        "npmVersion",
        "chromiumRevision"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    },
    "__schema4": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/__schema6"
        },
        "generatorVersion": {
          "$ref": "#/$defs/__schema3"
        },
        "seed": {
          "$ref": "#/$defs/__schema7"
        },
        "cutoffAt": {
          "$ref": "#/$defs/__schema8"
        },
        "schemaVersion": {
          "$ref": "#/$defs/__schema3"
        },
        "contestCount": {
          "$ref": "#/$defs/__schema10"
        },
        "problemCount": {
          "$ref": "#/$defs/__schema11"
        },
        "tagCount": {
          "$ref": "#/$defs/__schema12"
        },
        "learningUnitCount": {
          "$ref": "#/$defs/__schema13"
        },
        "fileListDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "catalogDigest": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "kind",
        "generatorVersion",
        "seed",
        "cutoffAt",
        "schemaVersion",
        "contestCount",
        "problemCount",
        "tagCount",
        "learningUnitCount",
        "fileListDigest",
        "catalogDigest"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "enum": [
        "seed",
        "release-cutoff",
        "design-limit"
      ]
    },
    "__schema7": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema3"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema8": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema9"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema9": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema10": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema11": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema12": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema13": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema14": {
      "minItems": 9,
      "maxItems": 9,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema15"
      }
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "fixtureKind": {
          "type": "string",
          "enum": [
            "seed",
            "release-cutoff",
            "design-limit"
          ]
        },
        "fixtureDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 300000
        },
        "rawEvidenceDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "passed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "fixtureKind",
        "fixtureDigest",
        "run",
        "durationMs",
        "rawEvidenceDigest",
        "passed"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "fixtureDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "startMarker": {
          "type": "string",
          "const": "before-input-event"
        },
        "endMarker": {
          "type": "string",
          "const": "count-and-list-dom-committed"
        },
        "warmupCount": {
          "type": "number",
          "const": 10
        },
        "sampleCount": {
          "type": "number",
          "const": 30
        },
        "p95Ms": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sampleDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "rawEvidenceDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "passed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "fixtureDigest",
        "startMarker",
        "endMarker",
        "warmupCount",
        "sampleCount",
        "p95Ms",
        "sampleDigest",
        "rawEvidenceDigest",
        "passed"
      ],
      "additionalProperties": false
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "fixtureDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "contestId": {
          "type": "string",
          "pattern": "^abc[0-9]{3,}$"
        },
        "startMarker": {
          "type": "string",
          "const": "command-start"
        },
        "endMarker": {
          "type": "string",
          "const": "successful-command-exit-after-all-authoring-results-persisted"
        },
        "startedMonotonicMs": {
          "type": "number",
          "minimum": 0
        },
        "completedMonotonicMs": {
          "type": "number",
          "minimum": 0
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 900000
        },
        "problemResultCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "authoringResultCounts": {
          "type": "object",
          "properties": {
            "explanation_draft": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "authoring_required": {
              "type": "number",
              "const": 0
            },
            "blocked": {
              "type": "number",
              "const": 0
            }
          },
          "required": [
            "explanation_draft",
            "authoring_required",
            "blocked"
          ],
          "additionalProperties": false
        },
        "rawEvidenceDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "exitCode": {
          "type": "number",
          "const": 0
        },
        "passed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "fixtureDigest",
        "contestId",
        "startMarker",
        "endMarker",
        "startedMonotonicMs",
        "completedMonotonicMs",
        "durationMs",
        "problemResultCount",
        "authoringResultCounts",
        "rawEvidenceDigest",
        "exitCode",
        "passed"
      ],
      "additionalProperties": false
    }
  }
}
