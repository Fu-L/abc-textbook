{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "candidateId": {
      "$ref": "#/$defs/__schema1"
    },
    "releaseKind": {
      "$ref": "#/$defs/__schema2"
    },
    "targetReleaseVersion": {
      "$ref": "#/$defs/__schema3"
    },
    "baseReleaseVersion": {
      "$ref": "#/$defs/__schema4"
    },
    "cutoffAt": {
      "$ref": "#/$defs/__schema5"
    },
    "orderedUpdateIds": {
      "$ref": "#/$defs/__schema6"
    },
    "fixtureMode": {
      "$ref": "#/$defs/__schema8"
    },
    "advancedSlotRegistryDigest": {
      "$ref": "#/$defs/__schema9"
    },
    "workManifestDigest": {
      "$ref": "#/$defs/__schema9"
    },
    "catalogContentSnapshotDigest": {
      "$ref": "#/$defs/__schema9"
    },
    "contentFiles": {
      "$ref": "#/$defs/__schema10"
    },
    "contentSubjectDigest": {
      "$ref": "#/$defs/__schema9"
    },
    "preJudgmentCheckRefs": {
      "$ref": "#/$defs/__schema13"
    },
    "humanContentReviewEvidenceRefs": {
      "$ref": "#/$defs/__schema15"
    },
    "blockingFindings": {
      "$ref": "#/$defs/__schema16"
    },
    "candidateFiles": {
      "$ref": "#/$defs/__schema17"
    },
    "candidatePayloadDigest": {
      "$ref": "#/$defs/__schema18"
    },
    "approvableDigest": {
      "$ref": "#/$defs/__schema19"
    },
    "ownerApproval": {
      "$ref": "#/$defs/__schema20"
    },
    "publicationEffectiveAt": {
      "$ref": "#/$defs/__schema21"
    },
    "publicationWindowEndsAt": {
      "$ref": "#/$defs/__schema22"
    },
    "state": {
      "$ref": "#/$defs/__schema23"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema5"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema5"
    }
  },
  "required": [
    "schemaVersion",
    "candidateId",
    "releaseKind",
    "targetReleaseVersion",
    "baseReleaseVersion",
    "cutoffAt",
    "orderedUpdateIds",
    "fixtureMode",
    "advancedSlotRegistryDigest",
    "workManifestDigest",
    "catalogContentSnapshotDigest",
    "contentFiles",
    "contentSubjectDigest",
    "preJudgmentCheckRefs",
    "humanContentReviewEvidenceRefs",
    "blockingFindings",
    "candidateFiles",
    "candidatePayloadDigest",
    "approvableDigest",
    "ownerApproval",
    "publicationEffectiveAt",
    "publicationWindowEndsAt",
    "state",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "READY_TO_PUBLISH",
              "PUBLISHED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "contentFiles": {
            "minItems": 1
          },
          "fixtureMode": {
            "const": false
          },
          "preJudgmentCheckRefs": {
            "minItems": 1
          },
          "humanContentReviewEvidenceRefs": {
            "minItems": 1
          },
          "candidateFiles": {
            "minItems": 1
          },
          "candidatePayloadDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approvableDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "ownerApproval": {
            "type": "object"
          },
          "publicationEffectiveAt": {
            "type": "string"
          },
          "publicationWindowEndsAt": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$id": "https://abc-textbook.local/schemas/release-candidate.schema.json",
  "title": "ABC Textbook Release Candidate",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "2.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^release-candidate-\\d{4}\\.\\d{2}\\.\\d+-[a-f0-9]{12,64}$"
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "initial",
        "incremental"
      ]
    },
    "__schema3": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "__schema4": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema3"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema5": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema6": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      },
      "uniqueItems": true
    },
    "__schema7": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "__schema8": {
      "type": "boolean"
    },
    "__schema9": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema10": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      }
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/__schema12"
        },
        "sha256": {
          "$ref": "#/$defs/__schema9"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*\\/$)(?!.*\\/\\/)(?!^(?:\\.{1,2})(?:\\/|$))(?!.*\\/(?:\\.{1,2})(?:\\/|$))[A-Za-z0-9._/-]+$"
    },
    "__schema13": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "$ref": "#/$defs/__schema7"
          },
          "checkType": {
            "type": "string",
            "enum": [
              "automated",
              "human_content_review",
              "learner_outcome",
              "user_timing",
              "other"
            ]
          },
          "subjectDigest": {
            "$ref": "#/$defs/__schema9"
          },
          "command": {
            "$ref": "#/$defs/__schema14"
          },
          "exitCode": {
            "type": "number",
            "const": 0
          },
          "resultPath": {
            "$ref": "#/$defs/__schema12"
          },
          "resultDigest": {
            "$ref": "#/$defs/__schema9"
          },
          "completedAt": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "required": [
          "checkId",
          "checkType",
          "subjectDigest",
          "command",
          "exitCode",
          "resultPath",
          "resultDigest",
          "completedAt"
        ],
        "additionalProperties": false
      }
    },
    "__schema14": {
      "type": "string",
      "minLength": 1
    },
    "__schema15": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "$ref": "#/$defs/__schema7"
          },
          "path": {
            "$ref": "#/$defs/__schema12"
          },
          "digest": {
            "$ref": "#/$defs/__schema9"
          },
          "subjectDigest": {
            "$ref": "#/$defs/__schema9"
          },
          "reviewerExecutedCheckSetDigest": {
            "$ref": "#/$defs/__schema9"
          },
          "reviewMode": {
            "type": "string",
            "enum": [
              "self",
              "third_party"
            ]
          },
          "aggregatePassed": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "evidenceId",
          "path",
          "digest",
          "subjectDigest",
          "reviewerExecutedCheckSetDigest",
          "reviewMode",
          "aggregatePassed"
        ],
        "additionalProperties": false
      }
    },
    "__schema16": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/$defs/__schema14"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "entityId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "$ref": "#/$defs/__schema14"
          },
          "resolved": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "severity",
          "entityId",
          "message",
          "resolved"
        ],
        "additionalProperties": false
      }
    },
    "__schema17": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      }
    },
    "__schema18": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema9"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema19": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema9"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema20": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ownerId": {
              "$ref": "#/$defs/__schema7"
            },
            "approvedDigest": {
              "$ref": "#/$defs/__schema9"
            },
            "approvedAt": {
              "$ref": "#/$defs/__schema5"
            }
          },
          "required": [
            "ownerId",
            "approvedDigest",
            "approvedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema21": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema5"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema22": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema5"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema23": {
      "type": "string",
      "enum": [
        "DRAFTED",
        "VALIDATING",
        "AWAITING_REVIEW",
        "AWAITING_OWNER_APPROVAL",
        "AWAITING_FINAL_VALIDATION",
        "READY_TO_PUBLISH",
        "ON_HOLD",
        "PUBLISHED",
        "EXPIRED"
      ]
    }
  }
}
