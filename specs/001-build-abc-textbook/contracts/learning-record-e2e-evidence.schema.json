{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "releaseDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "automatedEngineMatrixVersion": {
      "$ref": "#/$defs/__schema2"
    },
    "catalogVersion": {
      "$ref": "#/$defs/__schema2"
    },
    "runs": {
      "$ref": "#/$defs/__schema3"
    },
    "rawEvidenceDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "aggregatePassed": {
      "$ref": "#/$defs/__schema6"
    },
    "generatedAt": {
      "$ref": "#/$defs/__schema5"
    }
  },
  "required": [
    "schemaVersion",
    "releaseDigest",
    "automatedEngineMatrixVersion",
    "catalogVersion",
    "runs",
    "rawEvidenceDigest",
    "aggregatePassed",
    "generatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://abc-textbook.local/schemas/learning-record-e2e-evidence.schema.json",
  "title": "ABC Textbook Learning Record E2E Evidence",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "minItems": 45,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "chromium",
            "firefox",
            "webkit"
          ]
        },
        "engineRevision": {
          "$ref": "#/$defs/__schema2"
        },
        "os": {
          "$ref": "#/$defs/__schema2"
        },
        "problemId": {
          "type": "string",
          "pattern": "^abc[0-9]{3,}-[a-z][a-z0-9+_-]*$"
        },
        "startMarker": {
          "type": "string",
          "const": "problem-detail-render-complete"
        },
        "endMarker": {
          "type": "string",
          "const": "both-save-confirmations-visible"
        },
        "startedMonotonicMs": {
          "type": "number",
          "minimum": 0
        },
        "completedMonotonicMs": {
          "type": "number",
          "minimum": 0
        },
        "durationMs": {
          "type": "number",
          "minimum": 0,
          "maximum": 30000
        },
        "statusPersisted": {
          "type": "boolean",
          "const": true
        },
        "reviewPersisted": {
          "type": "boolean",
          "const": true
        },
        "statusUpdatedAt": {
          "$ref": "#/$defs/__schema5"
        },
        "reviewUpdatedAt": {
          "$ref": "#/$defs/__schema5"
        },
        "reloadCompleted": {
          "type": "boolean",
          "const": true
        },
        "reloadedStatus": {
          "type": "string",
          "const": "completed"
        },
        "reloadedNeedsReview": {
          "type": "boolean",
          "const": true
        },
        "reloadedStatusUpdatedAt": {
          "$ref": "#/$defs/__schema5"
        },
        "reloadedReviewUpdatedAt": {
          "$ref": "#/$defs/__schema5"
        },
        "rollbackPassed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "engine",
        "engineRevision",
        "os",
        "problemId",
        "startMarker",
        "endMarker",
        "startedMonotonicMs",
        "completedMonotonicMs",
        "durationMs",
        "statusPersisted",
        "reviewPersisted",
        "statusUpdatedAt",
        "reviewUpdatedAt",
        "reloadCompleted",
        "reloadedStatus",
        "reloadedNeedsReview",
        "reloadedStatusUpdatedAt",
        "reloadedReviewUpdatedAt",
        "rollbackPassed"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema6": {
      "type": "boolean",
      "const": true
    }
  }
}
