{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-textbook.local/schemas/update-manifest.schema.json",
  "title": "ABC Textbook Publication Update",
  "description": "一回のContest追加・訂正・taxonomy変更・bootstrapを表す。advancedSlotLabelsは公式task orderでDより後の全labelを持ち、固定E〜Hへ制限しない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "updateId",
    "kind",
    "baseReleaseVersion",
    "contestId",
    "sourceSetFingerprint",
    "advancedSlotLabels",
    "operations",
    "authoringResults",
    "correctionImpactIds",
    "validationSummary",
    "state",
    "createdAt",
    "updatedAt",
    "fixtureMode"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "updateId": { "$ref": "#/$defs/id" },
    "kind": { "enum": ["contest_addition", "correction", "taxonomy", "bootstrap"] },
    "baseReleaseVersion": { "anyOf": [{ "$ref": "#/$defs/releaseVersion" }, { "type": "null" }] },
    "contestId": { "type": ["string", "null"], "pattern": "^abc[0-9]{3,}$" },
    "sourceSetFingerprint": { "$ref": "#/$defs/sha256" },
    "advancedSlotLabels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/problemLabel" },
      "description": "Contestの公式task orderでDより後に並ぶlabel。Contestを持つupdateでは全件必須。"
    },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
    "authoringResults": { "type": "array", "items": { "$ref": "#/$defs/authoringResult" } },
    "correctionImpactIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "validationSummary": { "$ref": "#/$defs/validationSummary" },
    "state": { "enum": ["PREPARING", "ON_HOLD", "ELIGIBLE_FOR_BATCH"] },
    "createdAt": { "$ref": "#/$defs/dateTime" },
    "updatedAt": { "$ref": "#/$defs/dateTime" },
    "fixtureMode": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "bootstrap" } }, "required": ["kind"] },
      "then": { "properties": { "baseReleaseVersion": { "type": "null" } } },
      "else": {
        "if": { "properties": { "kind": { "const": "contest_addition" } }, "required": ["kind"] },
        "then": {
          "properties": {
            "contestId": { "type": "string", "pattern": "^abc[0-9]{3,}$" },
            "advancedSlotLabels": { "minItems": 1 }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "ELIGIBLE_FOR_BATCH" } }, "required": ["state"] },
      "then": {
        "properties": {
          "authoringResults": {
            "items": { "properties": { "resultType": { "const": "explanation_draft" } }, "required": ["resultType"] }
          },
          "validationSummary": {
            "properties": { "blockingFindingCount": { "const": 0 }, "aggregatePassed": { "const": true } },
            "required": ["blockingFindingCount", "aggregatePassed"]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "releaseVersion": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "problemLabel": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^[A-Za-z][A-Za-z0-9+_-]*$" },
    "safePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$" },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "entityType", "entityId", "action", "path", "beforeDigest", "afterDigest"],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "entityType": { "enum": ["contest", "contest_slot", "problem", "technique_inventory", "tag", "learning_outcome", "learning_unit", "placement", "explanation", "claim", "example", "exercise", "assessment", "answer_material", "source", "correction_impact"] },
        "entityId": { "$ref": "#/$defs/id" },
        "action": { "enum": ["add", "replace", "remove"] },
        "path": { "$ref": "#/$defs/safePath" },
        "beforeDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "afterDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "authoringResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problemId", "slotLabel", "resultType", "draftPath", "packetPath", "templatePath", "reasonCode", "reason", "retryCondition"],
      "properties": {
        "problemId": { "$ref": "#/$defs/id" },
        "slotLabel": { "$ref": "#/$defs/problemLabel" },
        "resultType": { "enum": ["explanation_draft", "authoring_required", "blocked"] },
        "draftPath": { "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }] },
        "packetPath": { "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }] },
        "templatePath": { "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }] },
        "reasonCode": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "retryCondition": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "resultType": { "const": "explanation_draft" } }, "required": ["resultType"] },
          "then": { "properties": { "draftPath": { "$ref": "#/$defs/safePath" }, "reasonCode": { "type": "null" }, "reason": { "type": "null" } } }
        },
        {
          "if": { "properties": { "resultType": { "const": "authoring_required" } }, "required": ["resultType"] },
          "then": { "properties": { "packetPath": { "$ref": "#/$defs/safePath" }, "templatePath": { "$ref": "#/$defs/safePath" }, "reason": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "resultType": { "const": "blocked" } }, "required": ["resultType"] },
          "then": { "properties": { "reasonCode": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "retryCondition": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "validationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkIds", "problemResults", "blockingFindingCount", "aggregatePassed", "resultDigest"],
      "properties": {
        "checkIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "problemResults": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["problemId", "passed", "findingCodes", "remediation"],
            "properties": {
              "problemId": { "$ref": "#/$defs/id" },
              "passed": { "type": "boolean" },
              "findingCodes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "remediation": { "type": ["string", "null"] }
            }
          }
        },
        "blockingFindingCount": { "type": "integer", "minimum": 0 },
        "aggregatePassed": { "type": "boolean" },
        "resultDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
