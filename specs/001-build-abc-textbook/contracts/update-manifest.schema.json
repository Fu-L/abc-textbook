{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "updateId": {
      "$ref": "#/$defs/__schema1"
    },
    "kind": {
      "$ref": "#/$defs/__schema2"
    },
    "baseReleaseVersion": {
      "$ref": "#/$defs/__schema3"
    },
    "contestId": {
      "$ref": "#/$defs/__schema4"
    },
    "sourceSetFingerprint": {
      "$ref": "#/$defs/__schema5"
    },
    "advancedSlotLabels": {
      "$ref": "#/$defs/__schema6"
    },
    "targetProblemIds": {
      "$ref": "#/$defs/__schema8"
    },
    "operations": {
      "$ref": "#/$defs/__schema10"
    },
    "authoringResults": {
      "$ref": "#/$defs/__schema12"
    },
    "correctionImpactIds": {
      "$ref": "#/$defs/__schema20"
    },
    "validationSummary": {
      "$ref": "#/$defs/__schema21"
    },
    "state": {
      "$ref": "#/$defs/__schema22"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema23"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema23"
    },
    "fixtureMode": {
      "$ref": "#/$defs/__schema24"
    }
  },
  "required": [
    "schemaVersion",
    "updateId",
    "kind",
    "baseReleaseVersion",
    "contestId",
    "sourceSetFingerprint",
    "advancedSlotLabels",
    "targetProblemIds",
    "operations",
    "authoringResults",
    "correctionImpactIds",
    "validationSummary",
    "state",
    "createdAt",
    "updatedAt",
    "fixtureMode"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "ELIGIBLE_FOR_BATCH"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "authoringResults": {
            "minItems": 1,
            "items": {
              "properties": {
                "resultType": {
                  "const": "explanation_draft"
                }
              }
            }
          },
          "validationSummary": {
            "properties": {
              "aggregatePassed": {
                "const": true
              },
              "blockingFindingCount": {
                "const": 0
              },
              "problemResults": {
                "items": {
                  "properties": {
                    "passed": {
                      "const": true
                    },
                    "findingCodes": {
                      "maxItems": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$id": "https://abc-textbook.local/schemas/update-manifest.schema.json",
  "title": "ABC Textbook Publication Update",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "2.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "contest_addition",
        "correction",
        "taxonomy",
        "bootstrap"
      ]
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema4": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^abc[0-9]{3,}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema6": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      },
      "uniqueItems": true
    },
    "__schema7": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[A-Za-z][A-Za-z0-9+_-]*$"
    },
    "__schema8": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      },
      "uniqueItems": true
    },
    "__schema9": {
      "type": "string",
      "pattern": "^abc[0-9]{3,}-[a-z][a-z0-9+_-]*$"
    },
    "__schema10": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "operationId": {
            "$ref": "#/$defs/__schema1"
          },
          "entityType": {
            "type": "string",
            "enum": [
              "contest",
              "contest_slot",
              "problem",
              "technique_inventory",
              "tag",
              "learning_outcome",
              "learning_unit",
              "placement",
              "explanation",
              "claim",
              "example",
              "exercise",
              "assessment",
              "answer_material",
              "source",
              "correction_impact"
            ]
          },
          "entityId": {
            "$ref": "#/$defs/__schema1"
          },
          "action": {
            "type": "string",
            "enum": [
              "add",
              "replace",
              "remove"
            ]
          },
          "path": {
            "$ref": "#/$defs/__schema11"
          },
          "beforeDigest": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema5"
              },
              {
                "type": "null"
              }
            ]
          },
          "afterDigest": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema5"
              },
              {
                "type": "null"
              }
            ]
          },
          "affectedProblemIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema9"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "operationId",
          "entityType",
          "entityId",
          "action",
          "path",
          "beforeDigest",
          "afterDigest",
          "affectedProblemIds"
        ],
        "additionalProperties": false
      }
    },
    "__schema11": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*\\/$)(?!.*\\/\\/)(?!^(?:\\.{1,2})(?:\\/|$))(?!.*\\/(?:\\.{1,2})(?:\\/|$))[A-Za-z0-9._/-]+$"
    },
    "__schema12": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "problemId": {
            "$ref": "#/$defs/__schema9"
          },
          "slotLabel": {
            "$ref": "#/$defs/__schema7"
          },
          "resultType": {
            "$ref": "#/$defs/__schema13"
          },
          "draftPath": {
            "$ref": "#/$defs/__schema14"
          },
          "packetPath": {
            "$ref": "#/$defs/__schema15"
          },
          "templatePath": {
            "$ref": "#/$defs/__schema16"
          },
          "reasonCode": {
            "$ref": "#/$defs/__schema17"
          },
          "reason": {
            "$ref": "#/$defs/__schema18"
          },
          "retryCondition": {
            "$ref": "#/$defs/__schema19"
          }
        },
        "required": [
          "problemId",
          "slotLabel",
          "resultType",
          "draftPath",
          "packetPath",
          "templatePath",
          "reasonCode",
          "reason",
          "retryCondition"
        ],
        "additionalProperties": false
      }
    },
    "__schema13": {
      "type": "string",
      "enum": [
        "explanation_draft",
        "authoring_required",
        "blocked"
      ]
    },
    "__schema14": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema11"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema15": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema11"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema16": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema11"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema17": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema18": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema19": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema20": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      },
      "uniqueItems": true
    },
    "__schema21": {
      "type": "object",
      "properties": {
        "checkIds": {
          "minItems": 1,
          "$ref": "#/$defs/__schema20"
        },
        "problemResults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "problemId": {
                "$ref": "#/$defs/__schema9"
              },
              "passed": {
                "type": "boolean"
              },
              "findingCodes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "remediation": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "problemId",
              "passed",
              "findingCodes",
              "remediation"
            ],
            "additionalProperties": false
          }
        },
        "blockingFindingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "aggregatePassed": {
          "type": "boolean"
        },
        "resultDigest": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "checkIds",
        "problemResults",
        "blockingFindingCount",
        "aggregatePassed",
        "resultDigest"
      ],
      "additionalProperties": false
    },
    "__schema22": {
      "type": "string",
      "enum": [
        "PREPARING",
        "ON_HOLD",
        "ELIGIBLE_FOR_BATCH"
      ]
    },
    "__schema23": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema24": {
      "type": "boolean"
    }
  }
}
