{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "releaseDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "toolVersion": {
      "$ref": "#/$defs/__schema2"
    },
    "buildManifestVersion": {
      "$ref": "#/$defs/__schema2"
    },
    "buildManifestDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "rawArtifactPath": {
      "$ref": "#/$defs/__schema3"
    },
    "rawArtifactDigest": {
      "$ref": "#/$defs/__schema1"
    },
    "checkedDecisionCount": {
      "$ref": "#/$defs/__schema4"
    },
    "violationCount": {
      "$ref": "#/$defs/__schema5"
    },
    "routeChunkDecisions": {
      "$ref": "#/$defs/__schema6"
    },
    "aggregatePassed": {
      "$ref": "#/$defs/__schema13"
    },
    "generatedAt": {
      "$ref": "#/$defs/__schema14"
    }
  },
  "required": [
    "schemaVersion",
    "releaseDigest",
    "toolVersion",
    "buildManifestVersion",
    "buildManifestDigest",
    "rawArtifactPath",
    "rawArtifactDigest",
    "checkedDecisionCount",
    "violationCount",
    "routeChunkDecisions",
    "aggregatePassed",
    "generatedAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "aggregatePassed": {
            "const": true
          }
        },
        "required": [
          "aggregatePassed"
        ]
      },
      "then": {
        "properties": {
          "violationCount": {
            "const": 0
          },
          "routeChunkDecisions": {
            "items": {
              "properties": {
                "allowed": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  ],
  "$id": "https://abc-textbook.local/schemas/client-bundle-evidence.schema.json",
  "title": "ABC Textbook Client Bundle Evidence",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "type": "string",
      "pattern": "^(?!.*(?:^|\\/)(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.[A-Za-z0-9._-]+)?(?:\\/|$))(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])(?:\\/[A-Za-z0-9._-]*[A-Za-z0-9_-])*$"
    },
    "__schema4": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema7"
      },
      "uniqueItems": true
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "route": {
          "$ref": "#/$defs/__schema8"
        },
        "chunkPath": {
          "$ref": "#/$defs/__schema9"
        },
        "chunkDigest": {
          "$ref": "#/$defs/__schema1"
        },
        "containsLearningRecordBundle": {
          "$ref": "#/$defs/__schema10"
        },
        "allowed": {
          "$ref": "#/$defs/__schema11"
        },
        "decisionRule": {
          "$ref": "#/$defs/__schema12"
        },
        "rationale": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "route",
        "chunkPath",
        "chunkDigest",
        "containsLearningRecordBundle",
        "allowed",
        "decisionRule",
        "rationale"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "string",
      "pattern": "^\\/"
    },
    "__schema9": {
      "allOf": [
        {
          "pattern": "^(?!.*(?:^|\\/)(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.[A-Za-z0-9._-]+)?(?:\\/|$))(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])(?:\\/[A-Za-z0-9._-]*[A-Za-z0-9_-])*$"
        },
        {
          "pattern": "\\.(?:js|mjs)$"
        }
      ],
      "$ref": "#/$defs/__schema3"
    },
    "__schema10": {
      "type": "boolean"
    },
    "__schema11": {
      "type": "boolean"
    },
    "__schema12": {
      "type": "string",
      "enum": [
        "allowed_learning_record_route_delivery",
        "no_learning_record_bundle",
        "forbidden_route_delivery"
      ]
    },
    "__schema13": {
      "type": "boolean"
    },
    "__schema14": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
