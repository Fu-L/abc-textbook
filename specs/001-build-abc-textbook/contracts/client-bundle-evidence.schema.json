{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-textbook.local/schemas/client-bundle-evidence.schema.json",
  "title": "ABC Textbook Client Bundle Route Boundary Evidence",
  "description": "生成routeとclient chunkの対応をbuild manifestから全件検査し、学習記録用bundleを許可route以外へ配信しないことを示す版付き証跡。件数と実inventoryの一致は意味検証器でも検査する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseDigest",
    "toolVersion",
    "buildManifestVersion",
    "buildManifestDigest",
    "rawArtifactPath",
    "rawArtifactDigest",
    "checkedDecisionCount",
    "violationCount",
    "routeChunkDecisions",
    "aggregatePassed",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "releaseDigest": { "$ref": "#/$defs/sha256", "description": "対象Catalog Release.contentSnapshotDigestと完全一致する。Release.manifestDigest、candidateManifestDigest、candidatePayloadDigestを指定してはならない。" },
    "toolVersion": { "type": "string", "minLength": 1 },
    "buildManifestVersion": { "type": "string", "minLength": 1 },
    "buildManifestDigest": { "$ref": "#/$defs/sha256" },
    "rawArtifactPath": {
      "$ref": "#/$defs/safeRelativePath"
    },
    "rawArtifactDigest": { "$ref": "#/$defs/sha256" },
    "checkedDecisionCount": { "type": "integer", "minimum": 1 },
    "violationCount": { "type": "integer", "minimum": 0 },
    "routeChunkDecisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/routeChunkDecision" },
      "uniqueItems": true
    },
    "aggregatePassed": { "type": "boolean" },
    "generatedAt": { "$ref": "#/$defs/dateTime" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "aggregatePassed": { "const": true } },
        "required": ["aggregatePassed"]
      },
      "then": {
        "properties": {
          "violationCount": { "const": 0 },
          "routeChunkDecisions": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/routeChunkDecision" },
                { "properties": { "allowed": { "const": true } } }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "aggregatePassed": { "const": false } },
        "required": ["aggregatePassed"]
      },
      "then": {
        "properties": {
          "violationCount": { "minimum": 1 },
          "routeChunkDecisions": {
            "contains": {
              "allOf": [
                { "$ref": "#/$defs/routeChunkDecision" },
                { "properties": { "allowed": { "const": false } } }
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeRelativePath": { "type": "string", "minLength": 1, "pattern": "^(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[A-Za-z0-9._-]+)?(?:/|$))(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])(?:/[A-Za-z0-9._-]*[A-Za-z0-9_-])*$", "description": "全target OSで同じbytesへ正規化できるrepository-relative canonical slash-only regular-file path。portable ASCII segmentだけを許し、absolute/drive/UNC、backslash、dot/dot-dot/空segment、trailing dot/slash、Windows禁止文字/device nameを拒否し、symlink解決後もrepository root内に限定する。" },
    "dateTime": { "type": "string", "format": "date-time" },
    "routeChunkDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "chunkPath",
        "chunkDigest",
        "containsLearningRecordBundle",
        "allowed",
        "decisionRule",
        "rationale"
      ],
      "properties": {
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "chunkPath": {
          "allOf": [
            { "$ref": "#/$defs/safeRelativePath" },
            { "pattern": "\\.(?:js|mjs)$" }
          ]
        },
        "chunkDigest": { "$ref": "#/$defs/sha256" },
        "containsLearningRecordBundle": { "type": "boolean" },
        "allowed": { "type": "boolean" },
        "decisionRule": {
          "enum": [
            "allowed_learning_record_route_delivery",
            "no_learning_record_bundle",
            "forbidden_route_delivery"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "containsLearningRecordBundle": { "const": false } },
            "required": ["containsLearningRecordBundle"]
          },
          "then": {
            "properties": {
              "allowed": { "const": true },
              "decisionRule": { "const": "no_learning_record_bundle" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "containsLearningRecordBundle": { "const": true },
              "allowed": { "const": true }
            },
            "required": ["containsLearningRecordBundle", "allowed"]
          },
          "then": {
            "properties": {
              "route": {
                "anyOf": [
                  { "const": "/problems/" },
                  { "pattern": "^/problems/abc[0-9]{3,}-[a-z][a-z0-9+_-]*/$" },
                  { "const": "/contests/" },
                  { "const": "/review/" },
                  { "const": "/settings/learning-records/" }
                ]
              },
              "decisionRule": { "const": "allowed_learning_record_route_delivery" }
            }
          }
        },
        {
          "if": {
            "properties": { "allowed": { "const": false } },
            "required": ["allowed"]
          },
          "then": {
            "properties": {
              "containsLearningRecordBundle": { "const": true },
              "decisionRule": { "const": "forbidden_route_delivery" }
            }
          }
        }
      ]
    }
  }
}
