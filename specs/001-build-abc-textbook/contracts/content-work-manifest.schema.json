{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "manifestId": {
      "$ref": "#/$defs/__schema1"
    },
    "taskId": {
      "$ref": "#/$defs/__schema2"
    },
    "scopeDigest": {
      "$ref": "#/$defs/__schema3"
    },
    "digest": {
      "$ref": "#/$defs/__schema3"
    },
    "changeKind": {
      "$ref": "#/$defs/__schema4"
    },
    "requiredRequirementIds": {
      "$ref": "#/$defs/__schema5"
    },
    "learningOutcomeIds": {
      "$ref": "#/$defs/__schema7"
    },
    "outcomeImpact": {
      "$ref": "#/$defs/__schema9"
    },
    "reviewPolicy": {
      "$ref": "#/$defs/__schema11"
    },
    "reviewUnits": {
      "$ref": "#/$defs/__schema15"
    },
    "maintenanceBenefit": {
      "$ref": "#/$defs/__schema34"
    },
    "state": {
      "$ref": "#/$defs/__schema33"
    },
    "createdAt": {
      "$ref": "#/$defs/__schema35"
    },
    "updatedAt": {
      "$ref": "#/$defs/__schema35"
    }
  },
  "required": [
    "schemaVersion",
    "manifestId",
    "taskId",
    "scopeDigest",
    "digest",
    "changeKind",
    "requiredRequirementIds",
    "learningOutcomeIds",
    "outcomeImpact",
    "reviewPolicy",
    "reviewUnits",
    "maintenanceBenefit",
    "state",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://abc-textbook.local/schemas/content-work-manifest.schema.json",
  "title": "ABC Textbook Content Work Manifest",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "2.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^work-manifest-T\\d{3}(?:-[a-z0-9]+(?:-[a-z0-9]+)*)?$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^T\\d{3}$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema4": {
      "type": "string",
      "enum": [
        "content",
        "schema",
        "domain",
        "tooling",
        "abstraction",
        "documentation",
        "test",
        "operations",
        "mixed"
      ]
    },
    "__schema5": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      },
      "uniqueItems": true
    },
    "__schema6": {
      "type": "string",
      "pattern": "^(?:FR|SC|CQ)-\\d{3}$"
    },
    "__schema7": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      },
      "uniqueItems": true
    },
    "__schema8": {
      "type": "string",
      "pattern": "^outcome-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "affects_learning_outcomes",
            "none"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": [
        "kind",
        "rationale"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "string",
      "minLength": 1
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "requiredMode": {
          "$ref": "#/$defs/__schema12"
        },
        "riskReasons": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": [
        "requiredMode",
        "riskReasons"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string",
      "enum": [
        "self",
        "third_party"
      ]
    },
    "__schema13": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema14"
      },
      "uniqueItems": true
    },
    "__schema14": {
      "type": "string",
      "enum": [
        "official_source_conflict",
        "original_proof",
        "major_classification_change"
      ]
    },
    "__schema15": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema16"
      }
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "reviewUnitId": {
          "$ref": "#/$defs/__schema17"
        },
        "changeKind": {
          "$ref": "#/$defs/__schema4"
        },
        "itemIds": {
          "$ref": "#/$defs/__schema18"
        },
        "requirementIds": {
          "$ref": "#/$defs/__schema20"
        },
        "learningOutcomeIds": {
          "$ref": "#/$defs/__schema22"
        },
        "outcomeImpact": {
          "$ref": "#/$defs/__schema9"
        },
        "paths": {
          "$ref": "#/$defs/__schema23"
        },
        "dependencyReviewUnitIds": {
          "$ref": "#/$defs/__schema25"
        },
        "checkIds": {
          "$ref": "#/$defs/__schema27"
        },
        "evidenceRoles": {
          "$ref": "#/$defs/__schema29"
        },
        "maintenanceBenefit": {
          "$ref": "#/$defs/__schema31"
        },
        "owner": {
          "$ref": "#/$defs/__schema32"
        },
        "status": {
          "$ref": "#/$defs/__schema33"
        }
      },
      "required": [
        "reviewUnitId",
        "changeKind",
        "itemIds",
        "requirementIds",
        "learningOutcomeIds",
        "outcomeImpact",
        "paths",
        "dependencyReviewUnitIds",
        "checkIds",
        "evidenceRoles",
        "maintenanceBenefit",
        "owner",
        "status"
      ],
      "additionalProperties": false
    },
    "__schema17": {
      "type": "string",
      "pattern": "^RU-T\\d{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema18": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema19"
      },
      "uniqueItems": true
    },
    "__schema19": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "__schema20": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema21"
      },
      "uniqueItems": true
    },
    "__schema21": {
      "type": "string",
      "pattern": "^(?:FR|SC|CQ)-\\d{3}$"
    },
    "__schema22": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      },
      "uniqueItems": true
    },
    "__schema23": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema24"
      },
      "uniqueItems": true
    },
    "__schema24": {
      "type": "string",
      "pattern": "^(?!.*(?:^|\\/)(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.[A-Za-z0-9._-]+)?(?:\\/|$))(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])(?:\\/[A-Za-z0-9._-]*[A-Za-z0-9_-])*$"
    },
    "__schema25": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema26"
      },
      "uniqueItems": true
    },
    "__schema26": {
      "type": "string",
      "pattern": "^RU-T\\d{3}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema27": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema28"
      },
      "uniqueItems": true
    },
    "__schema28": {
      "type": "string",
      "pattern": "^check-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema29": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema30"
      },
      "uniqueItems": true
    },
    "__schema30": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "__schema31": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema10"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema32": {
      "type": "string",
      "pattern": "^person-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema33": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "verified",
        "complete",
        "blocked"
      ]
    },
    "__schema34": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema10"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema35": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
