{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-textbook.local/schemas/content-work-manifest.schema.json",
  "title": "ABC Textbook Logical-Change Work Manifest",
  "description": "contentだけに限定しないlogical changeを、独立査読・独立merge可能なreview unitへ事前分解する汎用契約。意味検証器はmanifestId/taskId/path、scopeDigestとdigest、requirement集合、item/pathの一意所有、review-unit dependency DAG、check/evidence coverage、state遷移、current evidenceを再計算する。union(reviewUnits[].requirementIds)はrequiredRequirementIdsと集合として完全一致し、未知・未割当・重複割当を許さない。substantive contentはLearning Outcomeを必須とし、tooling/abstractionまたはmixed内の該当unitは具体的maintenanceBenefitを必須にする。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "taskId",
    "scopeDigest",
    "digest",
    "changeKind",
    "requiredRequirementIds",
    "learningOutcomeIds",
    "outcomeImpact",
    "reviewUnits",
    "maintenanceBenefit",
    "state",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "manifestId": {
      "type": "string",
      "pattern": "^work-manifest-T[0-9]{3}(?:-[a-z0-9]+(?:-[a-z0-9]+)*)?$",
      "description": "taskIdと一致する安定ID。"
    },
    "taskId": { "type": "string", "pattern": "^T[0-9]{3}$" },
    "scopeDigest": {
      "$ref": "#/$defs/sha256",
      "description": "manifestが計画するlogical-change scopeの安定canonical digest。対象path bytesがまだ存在しない場合も、予定path、requirement、item、dependency、check/evidence roleを固定したscope projectionから算出する。"
    },
    "digest": {
      "$ref": "#/$defs/sha256",
      "description": "digest fieldだけを除外したmanifest documentのRFC 8785/JCS canonical JSON SHA-256。計画変更では既存値を黙って維持せず再計算する。"
    },
    "changeKind": {
      "enum": ["content", "schema", "domain", "tooling", "abstraction", "documentation", "test", "operations", "mixed"]
    },
    "requiredRequirementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirementId" },
      "description": "このlogical changeが満たすべき完全なrequirement集合。reviewUnits[].requirementIdsのunionと集合として一致させる。"
    },
    "learningOutcomeIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/outcomeId" }
    },
    "outcomeImpact": { "$ref": "#/$defs/outcomeImpact" },
    "reviewUnits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reviewUnit" },
      "description": "reviewUnitId、itemIds、pathsは全unit間で一意。各item/pathは一つのunitだけが所有し、dependencyReviewUnitIdsは既知unitだけからなる非循環DAGにする。"
    },
    "maintenanceBenefit": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ],
      "description": "task全体に共通するtooling/abstractionの具体的保守効果。単なる対象外理由ではなく、重複削減、変更点局所化、検証範囲縮小等を記述する。unit固有効果は各reviewUnitへも記録する。"
    },
    "state": { "$ref": "#/$defs/state" },
    "createdAt": { "$ref": "#/$defs/dateTime" },
    "updatedAt": {
      "$ref": "#/$defs/dateTime",
      "description": "createdAt以後。state、scope、review unitまたはdigest更新時に更新する。"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "changeKind": { "enum": ["tooling", "abstraction"] } }, "required": ["changeKind"] },
      "then": { "properties": { "maintenanceBenefit": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "changeKind": { "const": "content" } }, "required": ["changeKind"] },
      "then": {
        "properties": {
          "learningOutcomeIds": { "minItems": 1 },
          "outcomeImpact": {
            "allOf": [
              { "$ref": "#/$defs/outcomeImpact" },
              { "properties": { "kind": { "const": "affects_learning_outcomes" } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "learningOutcomeIds": { "maxItems": 0 } }, "required": ["learningOutcomeIds"] },
      "then": {
        "properties": {
          "outcomeImpact": {
            "allOf": [
              { "$ref": "#/$defs/outcomeImpact" },
              { "properties": { "kind": { "const": "none" } } }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "outcomeImpact": {
            "allOf": [
              { "$ref": "#/$defs/outcomeImpact" },
              { "properties": { "kind": { "const": "affects_learning_outcomes" } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "verified" } }, "required": ["state"] },
      "then": {
        "properties": {
          "reviewUnits": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/reviewUnit" },
                { "properties": { "status": { "enum": ["verified", "complete"] } } }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "complete" } }, "required": ["state"] },
      "then": {
        "properties": {
          "reviewUnits": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/reviewUnit" },
                { "properties": { "status": { "const": "complete" } } }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "state": { "enum": ["planned", "in_progress", "verified", "complete", "blocked"] },
    "requirementId": { "type": "string", "pattern": "^(?:FR|SC|CQ)-[0-9]{3}$" },
    "outcomeId": { "type": "string", "pattern": "^outcome-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "personId": { "type": "string", "pattern": "^person-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[A-Za-z0-9._-]+)?(?:/|$))(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])(?:/[A-Za-z0-9._-]*[A-Za-z0-9_-])*$",
      "description": "portable ASCIIのrepository-relative canonical slash-only path。absolute/drive/UNC、backslash、dot/dot-dot/空segment、trailing dot/slash、Windows device nameを拒否する。"
    },
    "outcomeImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "rationale"],
      "properties": {
        "kind": { "enum": ["affects_learning_outcomes", "none"] },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "影響する成果との関係、または非教材変更で成果影響がない具体的理由。bare booleanや『対象外』だけの記述は禁止する。"
        }
      }
    },
    "reviewUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewUnitId",
        "changeKind",
        "itemIds",
        "requirementIds",
        "learningOutcomeIds",
        "outcomeImpact",
        "paths",
        "dependencyReviewUnitIds",
        "checkIds",
        "evidenceRoles",
        "maintenanceBenefit",
        "owner",
        "status"
      ],
      "properties": {
        "reviewUnitId": { "type": "string", "pattern": "^RU-T[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "changeKind": { "enum": ["content", "schema", "domain", "tooling", "abstraction", "documentation", "test", "operations", "mixed"] },
        "itemIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" } },
        "requirementIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/requirementId" } },
        "learningOutcomeIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/outcomeId" } },
        "outcomeImpact": { "$ref": "#/$defs/outcomeImpact" },
        "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeRelativePath" } },
        "dependencyReviewUnitIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^RU-T[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "checkIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^check-[a-z0-9]+(?:-[a-z0-9]+)*$" } },
        "evidenceRoles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" } },
        "maintenanceBenefit": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ],
          "description": "このunitが追加するtooling/abstraction/共通化の具体的保守効果。"
        },
        "owner": { "$ref": "#/$defs/personId" },
        "status": { "$ref": "#/$defs/state" }
      },
      "allOf": [
        {
          "if": { "properties": { "changeKind": { "enum": ["tooling", "abstraction"] } }, "required": ["changeKind"] },
          "then": { "properties": { "maintenanceBenefit": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "changeKind": { "const": "content" } }, "required": ["changeKind"] },
          "then": {
            "properties": {
              "learningOutcomeIds": { "minItems": 1 },
              "outcomeImpact": {
                "allOf": [
                  { "$ref": "#/$defs/outcomeImpact" },
                  { "properties": { "kind": { "const": "affects_learning_outcomes" } } }
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "learningOutcomeIds": { "maxItems": 0 } }, "required": ["learningOutcomeIds"] },
          "then": {
            "properties": {
              "outcomeImpact": {
                "allOf": [
                  { "$ref": "#/$defs/outcomeImpact" },
                  { "properties": { "kind": { "const": "none" } } }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "outcomeImpact": {
                "allOf": [
                  { "$ref": "#/$defs/outcomeImpact" },
                  { "properties": { "kind": { "const": "affects_learning_outcomes" } } }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
