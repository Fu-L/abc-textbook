{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/__schema0"
    },
    {
      "$ref": "#/$defs/__schema15"
    }
  ],
  "$id": "https://abc-textbook.local/schemas/user-timing-evidence.schema.json",
  "title": "ABC Textbook Sole User Timing Evidence",
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "criterionId": {
          "$ref": "#/$defs/__schema2"
        },
        "releaseVersion": {
          "$ref": "#/$defs/__schema3"
        },
        "releaseDigest": {
          "$ref": "#/$defs/__schema4"
        },
        "revision": {
          "$ref": "#/$defs/__schema5"
        },
        "actorRole": {
          "$ref": "#/$defs/__schema6"
        },
        "problemId": {
          "$ref": "#/$defs/__schema7"
        },
        "documentKind": {
          "type": "string",
          "const": "user_timing_protocol"
        },
        "artifactPath": {
          "$ref": "#/$defs/__schema8"
        },
        "routeEquivalence": {
          "type": "object",
          "properties": {
            "inventoryPath": {
              "$ref": "#/$defs/__schema8"
            },
            "inventoryDigest": {
              "$ref": "#/$defs/__schema4"
            },
            "inventoryCount": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sharedComponents": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema9"
              }
            },
            "sharedComponentSetDigest": {
              "$ref": "#/$defs/__schema4"
            },
            "actionContract": {
              "$ref": "#/$defs/__schema10"
            },
            "representativeProblemId": {
              "$ref": "#/$defs/__schema7"
            },
            "expectedCheckedRouteCount": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "inventoryPath",
            "inventoryDigest",
            "inventoryCount",
            "sharedComponents",
            "sharedComponentSetDigest",
            "actionContract",
            "representativeProblemId",
            "expectedCheckedRouteCount"
          ],
          "additionalProperties": false
        },
        "fixedAt": {
          "$ref": "#/$defs/__schema13"
        },
        "measurementStartsAfter": {
          "$ref": "#/$defs/__schema13"
        },
        "startMarker": {
          "type": "string",
          "const": "problem-detail-render-complete"
        },
        "endMarker": {
          "type": "string",
          "const": "both-save-confirmations-visible"
        },
        "requiredOperations": {
          "$ref": "#/$defs/__schema11"
        },
        "additionalNavigationAllowed": {
          "type": "boolean",
          "const": false
        },
        "externalInstructionsAllowed": {
          "type": "boolean",
          "const": false
        },
        "clockKind": {
          "type": "string",
          "const": "monotonic"
        },
        "maximumDurationMs": {
          "type": "number",
          "const": 30000
        },
        "reloadAssertions": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema14"
          }
        },
        "protocolDigest": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "schemaVersion",
        "criterionId",
        "releaseVersion",
        "releaseDigest",
        "revision",
        "actorRole",
        "problemId",
        "documentKind",
        "artifactPath",
        "routeEquivalence",
        "fixedAt",
        "measurementStartsAfter",
        "startMarker",
        "endMarker",
        "requiredOperations",
        "additionalNavigationAllowed",
        "externalInstructionsAllowed",
        "clockKind",
        "maximumDurationMs",
        "reloadAssertions",
        "protocolDigest"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "const": "1.1.0"
    },
    "__schema2": {
      "type": "string",
      "const": "SC-012"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "__schema4": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema5": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "type": "string",
      "const": "sole_operator_learner"
    },
    "__schema7": {
      "type": "string",
      "pattern": "^abc[0-9]{3,}-[a-z][a-z0-9+_-]*$"
    },
    "__schema8": {
      "type": "string",
      "pattern": "^(?!.*(?:^|\\/)(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.[A-Za-z0-9._-]+)?(?:\\/|$))(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])(?:\\/[A-Za-z0-9._-]*[A-Za-z0-9_-])*$"
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?:src\\/components|src\\/lib\\/learning-records)\\/.+\\.(?:astro|ts|tsx)$"
        },
        "digest": {
          "$ref": "#/$defs/__schema4"
        },
        "byteLength": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "digest",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "contractId": {
          "type": "string",
          "const": "learning-record-direct-actions"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "path": {
          "$ref": "#/$defs/__schema8"
        },
        "digest": {
          "$ref": "#/$defs/__schema4"
        },
        "requiredActions": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": [
        "contractId",
        "version",
        "path",
        "digest",
        "requiredActions"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      }
    },
    "__schema12": {
      "type": "string",
      "enum": [
        "set_status_completed",
        "set_needs_review_true"
      ]
    },
    "__schema13": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema14": {
      "type": "string",
      "enum": [
        "status_completed",
        "needs_review_true",
        "status_updated_at_preserved",
        "review_updated_at_preserved"
      ]
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/__schema1"
        },
        "criterionId": {
          "$ref": "#/$defs/__schema2"
        },
        "releaseVersion": {
          "$ref": "#/$defs/__schema3"
        },
        "releaseDigest": {
          "$ref": "#/$defs/__schema4"
        },
        "revision": {
          "$ref": "#/$defs/__schema5"
        },
        "actorRole": {
          "$ref": "#/$defs/__schema6"
        },
        "problemId": {
          "$ref": "#/$defs/__schema7"
        },
        "documentKind": {
          "type": "string",
          "const": "user_timing_result"
        },
        "artifactPath": {
          "$ref": "#/$defs/__schema8"
        },
        "protocolPath": {
          "$ref": "#/$defs/__schema8"
        },
        "protocolDigest": {
          "$ref": "#/$defs/__schema4"
        },
        "routeEquivalence": {
          "type": "object",
          "properties": {
            "inventoryPath": {
              "$ref": "#/$defs/__schema8"
            },
            "inventoryDigest": {
              "$ref": "#/$defs/__schema4"
            },
            "inventoryCount": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sharedComponents": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema9"
              }
            },
            "sharedComponentSetDigest": {
              "$ref": "#/$defs/__schema4"
            },
            "actionContract": {
              "$ref": "#/$defs/__schema10"
            },
            "representativeProblemId": {
              "$ref": "#/$defs/__schema7"
            },
            "routeChecks": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema16"
              }
            },
            "checkedRouteCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "passedRouteCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "failedRouteCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "aggregatePassed": {
              "type": "boolean"
            },
            "failureReasons": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema17"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "inventoryPath",
            "inventoryDigest",
            "inventoryCount",
            "sharedComponents",
            "sharedComponentSetDigest",
            "actionContract",
            "representativeProblemId",
            "routeChecks",
            "checkedRouteCount",
            "passedRouteCount",
            "failedRouteCount",
            "aggregatePassed",
            "failureReasons"
          ],
          "additionalProperties": false
        },
        "startMarker": {
          "type": "string",
          "const": "problem-detail-render-complete"
        },
        "endMarker": {
          "type": "string",
          "const": "both-save-confirmations-visible"
        },
        "startedMonotonicMs": {
          "type": "number",
          "minimum": 0
        },
        "completedMonotonicMs": {
          "type": "number",
          "minimum": 0
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "operations": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema18"
          }
        },
        "additionalNavigationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "externalInstructionUsed": {
          "type": "boolean"
        },
        "reloadCompleted": {
          "type": "boolean"
        },
        "reloadedStatus": {
          "type": "string",
          "enum": [
            "not_started",
            "in_progress",
            "completed"
          ]
        },
        "reloadedNeedsReview": {
          "type": "boolean"
        },
        "reloadedStatusUpdatedAt": {
          "$ref": "#/$defs/__schema13"
        },
        "reloadedReviewUpdatedAt": {
          "$ref": "#/$defs/__schema13"
        },
        "statusUpdatedAtPreserved": {
          "type": "boolean"
        },
        "reviewUpdatedAtPreserved": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "failureReasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema17"
          },
          "uniqueItems": true
        },
        "rawFiles": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema19"
          }
        },
        "rawEvidenceDigest": {
          "$ref": "#/$defs/__schema4"
        },
        "generatedAt": {
          "$ref": "#/$defs/__schema13"
        },
        "resultDigest": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "schemaVersion",
        "criterionId",
        "releaseVersion",
        "releaseDigest",
        "revision",
        "actorRole",
        "problemId",
        "documentKind",
        "artifactPath",
        "protocolPath",
        "protocolDigest",
        "routeEquivalence",
        "startMarker",
        "endMarker",
        "startedMonotonicMs",
        "completedMonotonicMs",
        "durationMs",
        "operations",
        "additionalNavigationCount",
        "externalInstructionUsed",
        "reloadCompleted",
        "reloadedStatus",
        "reloadedNeedsReview",
        "reloadedStatusUpdatedAt",
        "reloadedReviewUpdatedAt",
        "statusUpdatedAtPreserved",
        "reviewUpdatedAtPreserved",
        "passed",
        "failureReasons",
        "rawFiles",
        "rawEvidenceDigest",
        "generatedAt",
        "resultDigest"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "problemId": {
          "$ref": "#/$defs/__schema7"
        },
        "routePath": {
          "$ref": "#/$defs/__schema17"
        },
        "routeDigest": {
          "$ref": "#/$defs/__schema4"
        },
        "sharedComponentSetDigest": {
          "$ref": "#/$defs/__schema4"
        },
        "actionContractDigest": {
          "$ref": "#/$defs/__schema4"
        },
        "sharedComponentRendered": {
          "type": "boolean"
        },
        "requiredActions": {
          "$ref": "#/$defs/__schema11"
        },
        "checkResultPath": {
          "$ref": "#/$defs/__schema8"
        },
        "checkResultDigest": {
          "$ref": "#/$defs/__schema4"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "checkedAt": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": [
        "problemId",
        "routePath",
        "routeDigest",
        "sharedComponentSetDigest",
        "actionContractDigest",
        "sharedComponentRendered",
        "requiredActions",
        "checkResultPath",
        "checkResultDigest",
        "status",
        "checkedAt"
      ],
      "additionalProperties": false
    },
    "__schema17": {
      "type": "string",
      "minLength": 1
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "set_status_completed",
            "set_needs_review_true"
          ]
        },
        "completedMonotonicMs": {
          "type": "number",
          "minimum": 0
        },
        "saveConfirmationObserved": {
          "type": "boolean"
        },
        "persistedUpdatedAt": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": [
        "operation",
        "completedMonotonicMs",
        "saveConfirmationObserved",
        "persistedUpdatedAt"
      ],
      "additionalProperties": false
    },
    "__schema19": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/__schema8"
        },
        "sha256": {
          "$ref": "#/$defs/__schema4"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false
    }
  }
}
