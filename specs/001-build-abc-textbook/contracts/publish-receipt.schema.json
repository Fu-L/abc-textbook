{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "receiptId": {
      "$ref": "#/$defs/__schema1"
    },
    "receiptPath": {
      "$ref": "#/$defs/__schema2"
    },
    "candidateId": {
      "$ref": "#/$defs/__schema3"
    },
    "releaseVersion": {
      "$ref": "#/$defs/__schema4"
    },
    "contentSnapshotDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "candidatePayloadDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "approvableDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "publicationEffectiveAt": {
      "$ref": "#/$defs/__schema6"
    },
    "publicationWindowEndsAt": {
      "$ref": "#/$defs/__schema6"
    },
    "actualAtomicSwapAt": {
      "$ref": "#/$defs/__schema6"
    },
    "osFamily": {
      "$ref": "#/$defs/__schema7"
    },
    "osVersion": {
      "$ref": "#/$defs/__schema8"
    },
    "filesystem": {
      "$ref": "#/$defs/__schema8"
    },
    "toolVersions": {
      "$ref": "#/$defs/__schema9"
    },
    "previousReleaseVersion": {
      "$ref": "#/$defs/__schema11"
    },
    "newReleaseVersion": {
      "$ref": "#/$defs/__schema4"
    },
    "result": {
      "$ref": "#/$defs/__schema12"
    },
    "rawEvidenceDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "recordedAt": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "schemaVersion",
    "receiptId",
    "receiptPath",
    "candidateId",
    "releaseVersion",
    "contentSnapshotDigest",
    "candidatePayloadDigest",
    "approvableDigest",
    "publicationEffectiveAt",
    "publicationWindowEndsAt",
    "actualAtomicSwapAt",
    "osFamily",
    "osVersion",
    "filesystem",
    "toolVersions",
    "previousReleaseVersion",
    "newReleaseVersion",
    "result",
    "rawEvidenceDigest",
    "recordedAt"
  ],
  "additionalProperties": false,
  "$id": "https://abc-textbook.local/schemas/publish-receipt.schema.json",
  "title": "ABC Textbook Publish Receipt",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^publish-receipt-\\d{4}\\.\\d{2}\\.\\d+-[a-f0-9]{12,64}$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^docs\\/verification\\/publish-receipts\\/\\d{4}\\.\\d{2}\\.\\d+\\.json$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^release-candidate-\\d{4}\\.\\d{2}\\.\\d+-[a-f0-9]{12,64}$"
    },
    "__schema4": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema6": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema7": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "__schema8": {
      "type": "string",
      "minLength": 1
    },
    "__schema9": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema10"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema8"
      }
    },
    "__schema10": {
      "type": "string"
    },
    "__schema11": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema4"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema12": {
      "type": "string",
      "const": "published"
    }
  }
}
