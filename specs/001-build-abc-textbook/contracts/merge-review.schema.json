{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "changeId": {
      "$ref": "#/$defs/__schema1"
    },
    "logicalChangeSubjectDigest": {
      "$ref": "#/$defs/__schema2"
    },
    "subjectFiles": {
      "$ref": "#/$defs/__schema3"
    },
    "excludedArtifacts": {
      "$ref": "#/$defs/__schema6"
    },
    "workManifestPath": {
      "$ref": "#/$defs/__schema5"
    },
    "workManifestDigest": {
      "$ref": "#/$defs/__schema2"
    },
    "learningOutcomeIds": {
      "$ref": "#/$defs/__schema7"
    },
    "outcomeImpact": {
      "$ref": "#/$defs/__schema8"
    },
    "reviewMode": {
      "$ref": "#/$defs/__schema10"
    },
    "reviewerId": {
      "$ref": "#/$defs/__schema1"
    },
    "applicableChecks": {
      "$ref": "#/$defs/__schema11"
    },
    "notApplicableChecks": {
      "$ref": "#/$defs/__schema14"
    },
    "humanContentReviewEvidenceId": {
      "$ref": "#/$defs/__schema1"
    },
    "humanContentReviewEvidencePath": {
      "$ref": "#/$defs/__schema5"
    },
    "humanContentReviewEvidenceDigest": {
      "$ref": "#/$defs/__schema2"
    },
    "constitutionCheck": {
      "$ref": "#/$defs/__schema15"
    },
    "unresolvedBlockingFindingCount": {
      "$ref": "#/$defs/__schema16"
    },
    "mergeApproved": {
      "$ref": "#/$defs/__schema17"
    },
    "reviewedAt": {
      "$ref": "#/$defs/__schema13"
    },
    "evidenceDigest": {
      "$ref": "#/$defs/__schema2"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "changeId",
    "logicalChangeSubjectDigest",
    "subjectFiles",
    "excludedArtifacts",
    "workManifestPath",
    "workManifestDigest",
    "learningOutcomeIds",
    "outcomeImpact",
    "reviewMode",
    "reviewerId",
    "applicableChecks",
    "notApplicableChecks",
    "humanContentReviewEvidenceId",
    "humanContentReviewEvidencePath",
    "humanContentReviewEvidenceDigest",
    "constitutionCheck",
    "unresolvedBlockingFindingCount",
    "mergeApproved",
    "reviewedAt",
    "evidenceDigest"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mergeApproved": {
            "const": true
          }
        },
        "required": [
          "mergeApproved"
        ]
      },
      "then": {
        "properties": {
          "applicableChecks": {
            "items": {
              "properties": {
                "exitCode": {
                  "const": 0
                }
              }
            }
          },
          "constitutionCheck": {
            "properties": {
              "passed": {
                "const": true
              },
              "violationCount": {
                "const": 0
              }
            }
          },
          "unresolvedBlockingFindingCount": {
            "const": 0
          }
        }
      }
    }
  ],
  "$id": "https://abc-textbook.local/schemas/merge-review.schema.json",
  "title": "ABC Textbook Merge Review Evidence",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "3.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema3": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/__schema5"
        },
        "sha256": {
          "$ref": "#/$defs/__schema2"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*\\/$)(?!.*\\/\\/)(?!^(?:\\.{1,2})(?:\\/|$))(?!.*\\/(?:\\.{1,2})(?:\\/|$))[A-Za-z0-9._/-]+$"
    },
    "__schema6": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema7": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      },
      "uniqueItems": true
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "affects_learning_outcomes",
            "none"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/__schema9"
        }
      },
      "required": [
        "kind",
        "rationale"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "string",
      "minLength": 1
    },
    "__schema10": {
      "type": "string",
      "enum": [
        "self",
        "third_party"
      ]
    },
    "__schema11": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      }
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "checkId": {
          "$ref": "#/$defs/__schema1"
        },
        "executedByReviewerId": {
          "$ref": "#/$defs/__schema1"
        },
        "command": {
          "$ref": "#/$defs/__schema9"
        },
        "subjectDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "resultPath": {
          "$ref": "#/$defs/__schema5"
        },
        "resultDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "rawResultPath": {
          "$ref": "#/$defs/__schema5"
        },
        "rawResultDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "exitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "completedAt": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": [
        "checkId",
        "executedByReviewerId",
        "command",
        "subjectDigest",
        "resultPath",
        "resultDigest",
        "rawResultPath",
        "rawResultDigest",
        "exitCode",
        "completedAt"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema14": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "checkId": {
            "$ref": "#/$defs/__schema1"
          },
          "rationale": {
            "$ref": "#/$defs/__schema9"
          }
        },
        "required": [
          "checkId",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "constitutionPath": {
          "type": "string",
          "const": ".specify/memory/constitution.md"
        },
        "constitutionVersion": {
          "type": "string",
          "const": "2.0.0"
        },
        "constitutionDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "dependentTemplates": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema4"
          }
        },
        "violationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "boolean"
        },
        "checkedAt": {
          "$ref": "#/$defs/__schema13"
        }
      },
      "required": [
        "constitutionPath",
        "constitutionVersion",
        "constitutionDigest",
        "dependentTemplates",
        "violationCount",
        "passed",
        "checkedAt"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema17": {
      "type": "boolean"
    }
  }
}
