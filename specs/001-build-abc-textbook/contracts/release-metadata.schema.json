{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "$id": "https://abc-textbook.local/schemas/release-metadata.schema.json",
  "title": "ABC Textbook Git Release Metadata",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$ref": "#/$defs/__schema0",
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
        },
        "cutoffAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "changeSummary": {
          "type": "object",
          "properties": {
            "updateIds": {
              "$ref": "#/$defs/__schema1"
            },
            "addedProblemIds": {
              "$ref": "#/$defs/__schema3"
            },
            "changedProblemIds": {
              "$ref": "#/$defs/__schema5"
            },
            "withdrawnProblemIds": {
              "$ref": "#/$defs/__schema6"
            },
            "taxonomyChanges": {
              "$ref": "#/$defs/__schema7"
            }
          },
          "required": [
            "updateIds",
            "addedProblemIds",
            "changedProblemIds",
            "withdrawnProblemIds",
            "taxonomyChanges"
          ],
          "additionalProperties": false
        },
        "validationResultsUrl": {
          "type": "string",
          "pattern": "^https:\\/\\/",
          "format": "uri"
        }
      },
      "required": [
        "schemaVersion",
        "version",
        "cutoffAt",
        "commit",
        "changeSummary",
        "validationResultsUrl"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      },
      "uniqueItems": true
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "__schema3": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      },
      "uniqueItems": true
    },
    "__schema4": {
      "type": "string",
      "pattern": "^abc[0-9]{3,}-[a-z][a-z0-9+_-]*$"
    },
    "__schema5": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      },
      "uniqueItems": true
    },
    "__schema6": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      },
      "uniqueItems": true
    },
    "__schema7": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema8"
      },
      "uniqueItems": true
    },
    "__schema8": {
      "type": "string",
      "minLength": 1
    }
  }
}
