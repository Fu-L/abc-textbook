{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-textbook.local/schemas/prerequisite-baseline.schema.json",
  "title": "ABC Textbook Prerequisite Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "language", "skills", "excludedSkills", "sourceRevisionIds", "checkedAt", "digest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^prereq-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "language": { "const": "ja" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    },
    "excludedSkills": {
      "type": "array",
      "items": { "$ref": "#/$defs/excludedSkill" }
    },
    "sourceRevisionIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "checkedAt": { "type": "string", "format": "date-time" },
    "digest": {
      "$ref": "#/$defs/sha256",
      "description": "このJSON objectをkey順・array順・null表現までcanonical化し、自身のdigest fieldだけを除外して計算したSHA-256。"
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observableStatement", "verificationMethod"],
      "properties": {
        "id": { "type": "string", "pattern": "^skill-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "observableStatement": { "type": "string", "minLength": 1 },
        "verificationMethod": { "type": "string", "minLength": 1 }
      }
    },
    "excludedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rationale"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
