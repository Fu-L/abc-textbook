{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "version": {
      "$ref": "#/$defs/__schema2"
    },
    "name": {
      "$ref": "#/$defs/__schema3"
    },
    "language": {
      "$ref": "#/$defs/__schema4"
    },
    "skills": {
      "$ref": "#/$defs/__schema5"
    },
    "excludedSkills": {
      "$ref": "#/$defs/__schema7"
    },
    "sourceRevisionIds": {
      "$ref": "#/$defs/__schema8"
    },
    "checkedAt": {
      "$ref": "#/$defs/__schema9"
    },
    "digest": {
      "$ref": "#/$defs/__schema10"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "language",
    "skills",
    "excludedSkills",
    "sourceRevisionIds",
    "checkedAt",
    "digest"
  ],
  "additionalProperties": false,
  "$id": "https://abc-textbook.local/schemas/prerequisite-baseline.schema.json",
  "title": "ABC Textbook Prerequisite Baseline",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^prereq-[a-z0-9]+(?:-[a-z0-9]+)*-v\\d+$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    },
    "__schema4": {
      "type": "string",
      "const": "ja"
    },
    "__schema5": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^skill-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "observableStatement": {
          "$ref": "#/$defs/__schema3"
        },
        "verificationMethod": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "id",
        "observableStatement",
        "verificationMethod"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/__schema3"
          },
          "rationale": {
            "$ref": "#/$defs/__schema3"
          }
        },
        "required": [
          "name",
          "rationale"
        ],
        "additionalProperties": false
      }
    },
    "__schema8": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      },
      "uniqueItems": true
    },
    "__schema9": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema10": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
