{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "exportedAt": {
      "$ref": "#/$defs/__schema1"
    },
    "catalogVersionAtExport": {
      "$ref": "#/$defs/__schema2"
    },
    "records": {
      "$ref": "#/$defs/__schema3"
    },
    "orphanedProblemIds": {
      "$ref": "#/$defs/__schema5"
    }
  },
  "required": [
    "schemaVersion",
    "exportedAt",
    "catalogVersionAtExport",
    "records",
    "orphanedProblemIds"
  ],
  "additionalProperties": false,
  "$id": "https://abc-textbook.local/schemas/learning-record.schema.json",
  "title": "ABC Textbook Learning Record Backup",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "__schema3": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "problemId": {
            "$ref": "#/$defs/__schema4"
          },
          "status": {
            "type": "string",
            "enum": [
              "unstarted",
              "in_progress",
              "completed"
            ]
          },
          "statusUpdatedAt": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema1"
              },
              {
                "type": "null"
              }
            ]
          },
          "needsReview": {
            "type": "boolean"
          },
          "needsReviewUpdatedAt": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema1"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "problemId",
          "status",
          "statusUpdatedAt",
          "needsReview",
          "needsReviewUpdatedAt"
        ],
        "additionalProperties": false
      }
    },
    "__schema4": {
      "type": "string",
      "pattern": "^abc[0-9]{3,}-[a-z][a-z0-9+_-]*$"
    },
    "__schema5": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    }
  }
}
