{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-textbook.local/schemas/instruction-quality-evidence.schema.json",
  "title": "ABC Textbook Instruction Quality Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseDigest", "inventoryDigest", "inventoryCount", "checkedCount", "items", "automatedResultDigest", "humanReviewEvidenceIds", "blockingFindingCount", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "releaseDigest": { "$ref": "#/$defs/sha256" },
    "inventoryDigest": { "$ref": "#/$defs/sha256" },
    "inventoryCount": { "type": "integer", "minimum": 0 },
    "checkedCount": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "category", "path", "contentDigest", "learningOutcomeIds", "automatedPassed", "requiresHumanReview", "humanReviewItemId"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "category": { "enum": ["textbook", "explanation", "exercise", "answer", "ui", "cli", "operations"] },
          "path": { "type": "string", "minLength": 1 },
          "contentDigest": { "$ref": "#/$defs/sha256" },
          "learningOutcomeIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "automatedPassed": { "type": "boolean" },
          "requiresHumanReview": { "type": "boolean" },
          "humanReviewItemId": { "type": ["string", "null"] }
        }
      }
    },
    "automatedResultDigest": { "$ref": "#/$defs/sha256" },
    "humanReviewEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "blockingFindingCount": { "type": "integer", "minimum": 0 },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
