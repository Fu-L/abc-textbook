{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "evidenceId": {
      "$ref": "#/$defs/__schema1"
    },
    "releaseVersion": {
      "$ref": "#/$defs/__schema2"
    },
    "releaseDigest": {
      "$ref": "#/$defs/__schema3"
    },
    "operatorId": {
      "$ref": "#/$defs/__schema1"
    },
    "protocol": {
      "$ref": "#/$defs/__schema4"
    },
    "results": {
      "$ref": "#/$defs/__schema11"
    },
    "rawManifest": {
      "$ref": "#/$defs/__schema16"
    },
    "aggregatePassed": {
      "$ref": "#/$defs/__schema18"
    },
    "generatedAt": {
      "$ref": "#/$defs/__schema5"
    }
  },
  "required": [
    "schemaVersion",
    "evidenceId",
    "releaseVersion",
    "releaseDigest",
    "operatorId",
    "protocol",
    "results",
    "rawManifest",
    "aggregatePassed",
    "generatedAt"
  ],
  "additionalProperties": false,
  "$id": "https://abc-textbook.local/schemas/learner-outcome-evidence.schema.json",
  "title": "ABC Textbook Learner Outcome Evidence",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "2.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "protocolId": {
          "$ref": "#/$defs/__schema1"
        },
        "releaseDigest": {
          "$ref": "#/$defs/__schema3"
        },
        "fixedAt": {
          "$ref": "#/$defs/__schema5"
        },
        "sc009Items": {
          "minItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "sc010Items": {
          "minItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "rubrics": {
          "minItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema9"
          }
        },
        "passingRatio": {
          "type": "number",
          "const": 0.8
        }
      },
      "required": [
        "protocolId",
        "releaseDigest",
        "fixedAt",
        "sc009Items",
        "sc010Items",
        "rubrics",
        "passingRatio"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/__schema1"
        },
        "order": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "problemId": {
          "$ref": "#/$defs/__schema1"
        },
        "slotLabel": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Za-z][A-Za-z0-9+_-]*$"
        },
        "primaryGenre": {
          "$ref": "#/$defs/__schema7"
        },
        "expectedElements": {
          "minItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema7"
          }
        },
        "rubricId": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "itemId",
        "order",
        "problemId",
        "slotLabel",
        "primaryGenre",
        "expectedElements",
        "rubricId"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "string",
      "minLength": 1
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/__schema1"
        },
        "order": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "currentUnitId": {
          "$ref": "#/$defs/__schema1"
        },
        "primaryGenre": {
          "type": "string",
          "enum": [
            "graph",
            "dynamic-programming",
            "data-structure",
            "mathematics",
            "other"
          ]
        },
        "expectedNextUnitId": {
          "$ref": "#/$defs/__schema1"
        },
        "expectedPrerequisiteIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "expectedProblemId": {
          "$ref": "#/$defs/__schema1"
        },
        "rubricId": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "itemId",
        "order",
        "currentUnitId",
        "primaryGenre",
        "expectedNextUnitId",
        "expectedPrerequisiteIds",
        "expectedProblemId",
        "rubricId"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "rubricId": {
          "$ref": "#/$defs/__schema1"
        },
        "blockingItemIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          },
          "uniqueItems": true
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        }
      },
      "required": [
        "rubricId",
        "blockingItemIds",
        "items"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/__schema1"
        },
        "description": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "itemId",
        "description"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema12"
      }
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "criterionId": {
          "type": "string",
          "enum": [
            "SC-009",
            "SC-010"
          ]
        },
        "protocolId": {
          "$ref": "#/$defs/__schema1"
        },
        "releaseDigest": {
          "$ref": "#/$defs/__schema3"
        },
        "itemResults": {
          "minItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema13"
          }
        },
        "passedItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalItemCount": {
          "type": "integer",
          "minimum": 5,
          "maximum": 9007199254740991
        },
        "passRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "criterionId",
        "protocolId",
        "releaseDigest",
        "itemResults",
        "passedItemCount",
        "totalItemCount",
        "passRatio",
        "passed"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/__schema1"
        },
        "rawAnswerPath": {
          "$ref": "#/$defs/__schema14"
        },
        "rawAnswerDigest": {
          "$ref": "#/$defs/__schema3"
        },
        "rubricDecisions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema15"
          }
        },
        "allBlockingPassed": {
          "type": "boolean"
        },
        "evidenceNotes": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "itemId",
        "rawAnswerPath",
        "rawAnswerDigest",
        "rubricDecisions",
        "allBlockingPassed",
        "evidenceNotes"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*\\/$)(?!.*\\/\\/)(?!^(?:\\.{1,2})(?:\\/|$))(?!.*\\/(?:\\.{1,2})(?:\\/|$))[A-Za-z0-9._/-]+$"
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "rubricItemId": {
          "$ref": "#/$defs/__schema1"
        },
        "decision": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "rubricItemId",
        "decision",
        "rationale"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/__schema14"
        },
        "digest": {
          "$ref": "#/$defs/__schema3"
        },
        "fileCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "files": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema17"
          }
        }
      },
      "required": [
        "path",
        "digest",
        "fileCount",
        "files"
      ],
      "additionalProperties": false
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/__schema14"
        },
        "sha256": {
          "$ref": "#/$defs/__schema3"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "boolean"
    }
  }
}
