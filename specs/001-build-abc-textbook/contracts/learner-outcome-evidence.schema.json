{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/__schema0"
    },
    {
      "$ref": "#/$defs/__schema14"
    }
  ],
  "$id": "https://abc-textbook.local/schemas/learner-outcome-evidence.schema.json",
  "title": "ABC Textbook Learner Outcome Evidence",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "2.0.0"
        },
        "evidenceId": {
          "$ref": "#/$defs/__schema1"
        },
        "releaseVersion": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
        },
        "releaseDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "operatorId": {
          "$ref": "#/$defs/__schema1"
        },
        "protocol": {
          "type": "object",
          "properties": {
            "protocolId": {
              "$ref": "#/$defs/__schema1"
            },
            "releaseDigest": {
              "$ref": "#/$defs/__schema2"
            },
            "fixedAt": {
              "$ref": "#/$defs/__schema3"
            },
            "sc009Items": {
              "minItems": 5,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema4"
              }
            },
            "sc010Items": {
              "minItems": 5,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema6"
              }
            },
            "rubrics": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema7"
              }
            },
            "passingRatio": {
              "type": "number",
              "const": 0.8
            }
          },
          "required": [
            "protocolId",
            "releaseDigest",
            "fixedAt",
            "sc009Items",
            "rubrics",
            "passingRatio"
          ],
          "additionalProperties": false
        },
        "results": {
          "minItems": 1,
          "maxItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema9"
          },
          "contains": {
            "properties": {
              "criterionId": {
                "const": "SC-009"
              }
            },
            "required": [
              "criterionId"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "rawManifest": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/$defs/__schema11"
            },
            "digest": {
              "$ref": "#/$defs/__schema2"
            },
            "fileCount": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "files": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema13"
              }
            }
          },
          "required": [
            "path",
            "digest",
            "fileCount",
            "files"
          ],
          "additionalProperties": false
        },
        "aggregatePassed": {
          "type": "boolean"
        },
        "generatedAt": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "schemaVersion",
        "evidenceId",
        "releaseVersion",
        "releaseDigest",
        "operatorId",
        "protocol",
        "results",
        "rawManifest",
        "aggregatePassed",
        "generatedAt"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema3": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/__schema1"
        },
        "order": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "problemId": {
          "$ref": "#/$defs/__schema1"
        },
        "slotLabel": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[A-Za-z][A-Za-z0-9+_-]*$"
        },
        "primaryGenre": {
          "$ref": "#/$defs/__schema5"
        },
        "expectedElements": {
          "minItems": 4,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        "rubricId": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "itemId",
        "order",
        "problemId",
        "slotLabel",
        "primaryGenre",
        "expectedElements",
        "rubricId"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "minLength": 1
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/__schema1"
        },
        "order": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "currentUnitId": {
          "$ref": "#/$defs/__schema1"
        },
        "primaryGenre": {
          "type": "string",
          "enum": [
            "graph",
            "dynamic-programming",
            "data-structure",
            "mathematics",
            "other"
          ]
        },
        "expectedNextUnitId": {
          "$ref": "#/$defs/__schema1"
        },
        "expectedPrerequisiteIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "expectedProblemId": {
          "$ref": "#/$defs/__schema1"
        },
        "rubricId": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "itemId",
        "order",
        "currentUnitId",
        "primaryGenre",
        "expectedNextUnitId",
        "expectedPrerequisiteIds",
        "expectedProblemId",
        "rubricId"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "rubricId": {
          "$ref": "#/$defs/__schema1"
        },
        "blockingItemIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          },
          "uniqueItems": true
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        }
      },
      "required": [
        "rubricId",
        "blockingItemIds",
        "items"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/__schema1"
        },
        "description": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "itemId",
        "description"
      ],
      "additionalProperties": false
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "criterionId": {
          "type": "string",
          "enum": [
            "SC-009",
            "SC-010"
          ]
        },
        "protocolId": {
          "$ref": "#/$defs/__schema1"
        },
        "releaseDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "itemResults": {
          "minItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "passedItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalItemCount": {
          "type": "integer",
          "minimum": 5,
          "maximum": 9007199254740991
        },
        "passRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "criterionId",
        "protocolId",
        "releaseDigest",
        "itemResults",
        "passedItemCount",
        "totalItemCount",
        "passRatio",
        "passed"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "itemId": {
          "$ref": "#/$defs/__schema1"
        },
        "rawAnswerPath": {
          "$ref": "#/$defs/__schema11"
        },
        "rawAnswerDigest": {
          "$ref": "#/$defs/__schema2"
        },
        "rubricDecisions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema12"
          }
        },
        "allBlockingPassed": {
          "type": "boolean"
        },
        "evidenceNotes": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "itemId",
        "rawAnswerPath",
        "rawAnswerDigest",
        "rubricDecisions",
        "allBlockingPassed",
        "evidenceNotes"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*\\/$)(?!.*\\/\\/)(?!^(?:\\.{1,2})(?:\\/|$))(?!.*\\/(?:\\.{1,2})(?:\\/|$))[A-Za-z0-9._/-]+$"
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "rubricItemId": {
          "$ref": "#/$defs/__schema1"
        },
        "decision": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": [
        "rubricItemId",
        "decision",
        "rationale"
      ],
      "additionalProperties": false
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/__schema11"
        },
        "sha256": {
          "$ref": "#/$defs/__schema2"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "sha256",
        "byteLength"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "3.0.0"
        },
        "criterionId": {
          "type": "string",
          "const": "SC-009"
        },
        "status": {
          "type": "string",
          "const": "not_required_by_owner"
        },
        "scope": {
          "type": "string",
          "const": "initial_problem_corpus"
        },
        "decisionSource": {
          "type": "string",
          "const": "owner_instruction_issue_48"
        },
        "reason": {
          "$ref": "#/$defs/__schema5"
        },
        "replacementEvidencePaths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema11"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "criterionId",
        "status",
        "scope",
        "decisionSource",
        "reason",
        "replacementEvidencePaths"
      ],
      "additionalProperties": false
    }
  }
}
