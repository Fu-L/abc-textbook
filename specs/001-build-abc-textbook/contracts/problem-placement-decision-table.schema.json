{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "version": {
      "$ref": "#/$defs/__schema2"
    },
    "defaultMode": {
      "$ref": "#/$defs/__schema3"
    },
    "comparisonDimensions": {
      "$ref": "#/$defs/__schema4"
    },
    "inputAttributes": {
      "$ref": "#/$defs/__schema6"
    },
    "evaluationOrder": {
      "$ref": "#/$defs/__schema7"
    },
    "exclusiveResult": {
      "$ref": "#/$defs/__schema8"
    },
    "modeRules": {
      "$ref": "#/$defs/__schema9"
    },
    "ambiguousAction": {
      "$ref": "#/$defs/__schema15"
    },
    "digest": {
      "$ref": "#/$defs/__schema16"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "defaultMode",
    "comparisonDimensions",
    "inputAttributes",
    "evaluationOrder",
    "exclusiveResult",
    "modeRules",
    "ambiguousAction",
    "digest"
  ],
  "additionalProperties": false,
  "$id": "https://abc-textbook.local/schemas/problem-placement-decision-table.schema.json",
  "title": "ABC Textbook Problem Placement Decision Table",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "1.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^placement-policy-v\\d+$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "__schema3": {
      "type": "string",
      "const": "full"
    },
    "__schema4": {
      "minItems": 7,
      "maxItems": 7,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      },
      "uniqueItems": true
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "algorithm",
        "proof",
        "complexity",
        "constraints",
        "prerequisites",
        "implementation",
        "learning_outcomes"
      ]
    },
    "__schema6": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "primary_explanation_valid"
        },
        {
          "type": "string",
          "const": "algorithm_same"
        },
        {
          "type": "string",
          "const": "proof_same"
        },
        {
          "type": "string",
          "const": "complexity_same"
        },
        {
          "type": "string",
          "const": "constraints_difference_documented"
        },
        {
          "type": "string",
          "const": "prerequisites_same"
        },
        {
          "type": "string",
          "const": "implementation_difference_documented"
        },
        {
          "type": "string",
          "const": "learning_outcomes_same"
        },
        {
          "type": "string",
          "const": "additional_learning_count"
        },
        {
          "type": "string",
          "const": "evidence_complete"
        },
        {
          "type": "string",
          "const": "conflict_free"
        }
      ]
    },
    "__schema7": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "const": "similar"
        },
        {
          "type": "string",
          "const": "supplement"
        },
        {
          "type": "string",
          "const": "full"
        }
      ]
    },
    "__schema8": {
      "type": "boolean",
      "const": true
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "full": {
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "full"
            },
            "priority": {
              "type": "number",
              "const": 3
            },
            "fallback": {
              "type": "boolean",
              "const": true
            },
            "clauses": {
              "minItems": 0,
              "maxItems": 0,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema10"
              }
            },
            "requiredEvidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema12"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "result",
            "priority",
            "fallback",
            "clauses",
            "requiredEvidence"
          ],
          "additionalProperties": false
        },
        "similar": {
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "similar"
            },
            "priority": {
              "type": "number",
              "const": 1
            },
            "fallback": {
              "type": "boolean",
              "const": false
            },
            "clauses": {
              "minItems": 1,
              "maxItems": 9007199254740991,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema13"
              }
            },
            "requiredEvidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema12"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "result",
            "priority",
            "fallback",
            "clauses",
            "requiredEvidence"
          ],
          "additionalProperties": false
        },
        "supplement": {
          "type": "object",
          "properties": {
            "result": {
              "type": "string",
              "const": "supplement"
            },
            "priority": {
              "type": "number",
              "const": 2
            },
            "fallback": {
              "type": "boolean",
              "const": false
            },
            "clauses": {
              "minItems": 1,
              "maxItems": 9007199254740991,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema14"
              }
            },
            "requiredEvidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema12"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "result",
            "priority",
            "fallback",
            "clauses",
            "requiredEvidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "full",
        "similar",
        "supplement"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "all": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema11"
          }
        }
      },
      "required": [
        "all"
      ],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "attribute": {
          "type": "string",
          "enum": [
            "primary_explanation_valid",
            "algorithm_same",
            "proof_same",
            "complexity_same",
            "constraints_difference_documented",
            "prerequisites_same",
            "implementation_difference_documented",
            "learning_outcomes_same",
            "additional_learning_count",
            "evidence_complete",
            "conflict_free"
          ]
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "not_eq",
            "lt",
            "lte",
            "gt",
            "gte"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "attribute",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string",
      "enum": [
        "independent_full_explanation",
        "primary_explanation_id",
        "shared_learning_outcome_ids",
        "algorithm_comparison",
        "proof_comparison",
        "complexity_comparison",
        "constraint_comparison",
        "prerequisite_comparison",
        "implementation_comparison",
        "simplification_reason",
        "additional_learning",
        "answer_material",
        "source_revision_ids",
        "verification_evidence"
      ]
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "all": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema11"
          }
        }
      },
      "required": [
        "all"
      ],
      "additionalProperties": false
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "all": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema11"
          }
        }
      },
      "required": [
        "all"
      ],
      "additionalProperties": false
    },
    "__schema15": {
      "type": "string",
      "const": "on_hold"
    },
    "__schema16": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
