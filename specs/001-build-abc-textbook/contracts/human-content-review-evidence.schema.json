  "$id": "https://abc-textbook.local/schemas/human-content-review-evidence.schema.json",
  "title": "ABC Textbook Independent Human Content Review Evidence",
  "$comment": "Structural constraints are defined here; cross-field and collection invariants are enforced by the canonical Zod runtime validator.",
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "2.0.0"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^human-content-review-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "merge",
        "release_candidate"
      ]
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    },
    "__schema4": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema6": {
      "type": "string",
      "pattern": "^(?!.*(?:^|\\/)(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.[A-Za-z0-9._-]+)?(?:\\/|$))(?:[A-Za-z0-9._-]*[A-Za-z0-9_-])(?:\\/[A-Za-z0-9._-]*[A-Za-z0-9_-])*$"
    },
    "__schema7": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema8": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema9": {
      "type": "object",
      "properties": {
        "checkId": {
          "type": "string",
          "pattern": "^check-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "command": {
          "$ref": "#/$defs/__schema3"
        },
        "subjectDigest": {
          "$ref": "#/$defs/__schema5"
        },
        "resultPath": {
          "$ref": "#/$defs/__schema6"
        },
        "resultDigest": {
          "$ref": "#/$defs/__schema5"
        },
        "exitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "boolean"
        },
        "completedAt": {
          "$ref": "#/$defs/__schema10"
        },
        "executedByReviewerId": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": [
        "checkId",
        "command",
        "subjectDigest",
        "resultPath",
        "resultDigest",
        "exitCode",
        "passed",
        "completedAt",
        "executedByReviewerId"
      ],
      "additionalProperties": false
    },
    "__schema10": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema11": {
      "type": "string",
      "pattern": "^person-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema12": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "__schema13": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema14": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema15"
      }
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "personId": {
          "$ref": "#/$defs/__schema11"
        },
        "authoredItemIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema3"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "personId",
        "authoredItemIds"
      ],
      "additionalProperties": false
    },
    "__schema16": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema17"
      }
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "personId": {
          "$ref": "#/$defs/__schema11"
        },
        "role": {
          "type": "string",
          "const": "independent_human_content_reviewer"
        },
        "independenceDeclaration": {
          "$ref": "#/$defs/__schema3"
        },
        "countedAsOwnerApproval": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "personId",
        "role",
        "independenceDeclaration",
        "countedAsOwnerApproval"
      ],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewItemId": {
            "$ref": "#/$defs/__schema19"
          },
          "kind": {
            "$ref": "#/$defs/__schema20"
          },
          "subjectPaths": {
            "$ref": "#/$defs/__schema21"
          },
          "authorIds": {
            "$ref": "#/$defs/__schema22"
          },
          "learningOutcomeIds": {
            "$ref": "#/$defs/__schema23"
          },
          "reviewerId": {
            "$ref": "#/$defs/__schema11"
          },
          "reviewBasis": {
            "$ref": "#/$defs/__schema3"
          },
          "decision": {
            "$ref": "#/$defs/__schema25"
          },
          "findings": {
            "$ref": "#/$defs/__schema26"
          },
          "reviewedAt": {
            "$ref": "#/$defs/__schema10"
          }
        },
        "required": [
          "reviewItemId",
          "kind",
          "subjectPaths",
          "authorIds",
          "learningOutcomeIds",
          "reviewerId",
          "reviewBasis",
          "decision",
          "findings",
          "reviewedAt"
        ],
        "additionalProperties": false
      }
    },
    "__schema19": {
      "type": "string",
      "pattern": "^human-review-item-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema20": {
      "type": "string",
      "enum": [
        "outcome_coverage",
        "non_automatable_claim",
        "non_automatable_example"
      ]
    },
    "__schema21": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      },
      "uniqueItems": true
    },
    "__schema22": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      },
      "uniqueItems": true
    },
    "__schema23": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema24"
      },
      "uniqueItems": true
    },
    "__schema24": {
      "type": "string",
      "pattern": "^outcome-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "__schema25": {
      "type": "string",
      "enum": [
        "approved",
        "changes_requested"
      ]
    },
    "__schema26": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "findingId": {
            "type": "string",
            "pattern": "^human-review-finding-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "description": {
            "$ref": "#/$defs/__schema3"
          },
          "resolved": {
            "type": "boolean"
          },
          "evidenceRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema3"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "findingId",
          "severity",
          "description",
          "resolved",
          "evidenceRefs"
        ],
        "additionalProperties": false
      }
    },
    "__schema27": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema28": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema29": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema30": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema31": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema32": {
      "type": "object",
      "properties": {
        "reviewerId": {
          "$ref": "#/$defs/__schema11"
        },
        "authorIds": {
          "$ref": "#/$defs/__schema33"
        },
        "decision": {
          "$ref": "#/$defs/__schema34"
        },
        "learningOutcomeIds": {
          "$ref": "#/$defs/__schema35"
        },
        "subjectPaths": {
          "$ref": "#/$defs/__schema36"
        },
        "rationale": {
          "$ref": "#/$defs/__schema3"
        },
        "noOutcomeImpactRationale": {
          "$ref": "#/$defs/__schema37"
        },
        "confirmedAt": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": [
        "reviewerId",
        "authorIds",
        "decision",
        "learningOutcomeIds",
        "subjectPaths",
        "rationale",
        "noOutcomeImpactRationale",
        "confirmedAt"
      ],
      "additionalProperties": false
    },
    "__schema33": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema11"
      },
      "uniqueItems": true
    },
    "__schema34": {
      "type": "string",
      "enum": [
        "confirmed",
        "no_outcome_impact_confirmed"
      ]
    },
    "__schema35": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema24"
      },
      "uniqueItems": true
    },
    "__schema36": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      },
      "uniqueItems": true
    },
    "__schema37": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema3"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema38": {
      "type": "boolean"
    },
    "__schema39": {
      "type": "boolean"
    }
  }
}
