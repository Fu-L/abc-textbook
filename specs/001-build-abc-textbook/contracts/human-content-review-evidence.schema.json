{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "id": {
      "$ref": "#/$defs/__schema1"
    },
    "scopeType": {
      "$ref": "#/$defs/__schema2"
    },
    "scopeId": {
      "$ref": "#/$defs/__schema3"
    },
    "releaseVersion": {
      "$ref": "#/$defs/__schema4"
    },
    "subjectDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "inventoryPath": {
      "$ref": "#/$defs/__schema6"
    },
    "inventoryDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "rawEvidenceManifestPath": {
      "$ref": "#/$defs/__schema6"
    },
    "rawEvidenceManifestDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "rawEvidenceCount": {
      "$ref": "#/$defs/__schema7"
    },
    "artifactPath": {
      "$ref": "#/$defs/__schema6"
    },
    "applicableChecks": {
      "$ref": "#/$defs/__schema8"
    },
    "applicableCheckCount": {
      "$ref": "#/$defs/__schema12"
    },
    "passedApplicableCheckCount": {
      "$ref": "#/$defs/__schema13"
    },
    "reviewerExecutedCheckSetDigest": {
      "$ref": "#/$defs/__schema5"
    },
    "authors": {
      "$ref": "#/$defs/__schema14"
    },
    "reviewers": {
      "$ref": "#/$defs/__schema16"
    },
    "reviewItems": {
      "$ref": "#/$defs/__schema18"
    },
    "inventoryItemCount": {
      "$ref": "#/$defs/__schema27"
    },
    "reviewedItemCount": {
      "$ref": "#/$defs/__schema28"
    },
    "approvedItemCount": {
      "$ref": "#/$defs/__schema29"
    },
    "changesRequestedItemCount": {
      "$ref": "#/$defs/__schema30"
    },
    "unreviewedItemCount": {
      "$ref": "#/$defs/__schema31"
    },
    "outcomeCoverageReview": {
      "$ref": "#/$defs/__schema32"
    },
    "outcomeCoverageConfirmed": {
      "$ref": "#/$defs/__schema38"
    },
    "aggregatePassed": {
      "$ref": "#/$defs/__schema39"
    },
    "generatedAt": {
      "$ref": "#/$defs/__schema10"
    },
    "evidenceDigest": {
      "$ref": "#/$defs/__schema5"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "scopeType",
    "scopeId",
    "releaseVersion",
    "subjectDigest",
    "inventoryPath",
    "inventoryDigest",
    "rawEvidenceManifestPath",
    "rawEvidenceManifestDigest",
    "rawEvidenceCount",
    "artifactPath",
    "applicableChecks",
    "applicableCheckCount",
    "passedApplicableCheckCount",
    "reviewerExecutedCheckSetDigest",
    "authors",
    "reviewers",
    "reviewItems",
    "inventoryItemCount",
    "reviewedItemCount",
    "approvedItemCount",
    "changesRequestedItemCount",
    "unreviewedItemCount",
    "outcomeCoverageReview",
    "outcomeCoverageConfirmed",
    "aggregatePassed",
    "generatedAt",
    "evidenceDigest"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "aggregatePassed": {
            "const": true
          }
        },
        "required": [
          "aggregatePassed"
        ]
      },
      "then": {
        "properties": {
          "outcomeCoverageConfirmed": {
            "const": true
          },
          "changesRequestedItemCount": {
            "const": 0
          },
          "unreviewedItemCount": {
            "const": 0
          },
          "applicableChecks": {
            "items": {
              "properties": {
                "exitCode": {
                  "const": 0
                },
                "passed": {
                  "const": true
                }
              }
            }
          },
          "reviewItems": {
            "items": {
              "properties": {
                "decision": {
                  "const": "approved"
                }
              }
            }
          }
        }
      }
    }
