---
import SearchControl from '../components/SearchControl.astro';
import { publicCatalog, withBase } from '../lib/catalog/public-catalog.js';
import { buildSearchDocuments } from '../lib/catalog/search-documents.js';
import '../styles/global.css';
import TextbookContents from '../components/TextbookContents.astro';
import { textbookNavigation } from '../components/textbook-navigation.js';

interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  unitPage?: boolean;
  studyPreview?: boolean;
  title: string;
  description: string;
  searchTerms?: readonly string[];
  breadcrumbs?: Crumb[];
  previous?: Crumb | undefined;
  next?: Crumb | undefined;
}

const {
  title,
  studyPreview = false,
  unitPage = false,
  description,
  breadcrumbs = [],
  previous: suppliedPrevious,
  next: suppliedNext,
  searchTerms: additionalSearchTerms = [],
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(withBase(Astro.url.pathname.slice(base.length - 1), base), Astro.site);
const logicalPath = `/${Astro.url.pathname.slice(base.length).replace(/^\/+|\/+$/gu, '')}`;
const canonicalLogicalPath = logicalPath === '/' ? '/' : `${logicalPath}/`;
const learningPage = canonicalLogicalPath.startsWith('/learn/');
const navigation = textbookNavigation(publicCatalog.learningUnits, canonicalLogicalPath);
const previous =
  suppliedPrevious ??
  (navigation.previous && { href: navigation.previous.route, label: navigation.previous.title });
const next =
  suppliedNext ??
  (navigation.next && { href: navigation.next.route, label: navigation.next.title });
const pageBreadcrumbs =
  navigation.current && navigation.chapter
    ? [
        { href: '/learn/', label: '分野別目次' },
        ...(navigation.current.id === navigation.chapter.root.id
          ? []
          : [{ href: navigation.chapter.root.route, label: navigation.chapter.root.title }]),
        { label: navigation.current.title },
      ]
    : breadcrumbs;
const indexContent =
  !studyPreview && !['/review/', '/settings/learning-records/'].includes(canonicalLogicalPath);
const searchDocuments = buildSearchDocuments(publicCatalog).filter(
  ({ route }) => route === canonicalLogicalPath,
);
const searchTerms = [
  ...new Set([...searchDocuments.flatMap(({ terms }) => terms), ...additionalSearchTerms]),
];
const navItems = [
  ['学習経路', '/learn/'],
  ['問題', '/problems/'],
  ['典型タグ', '/tags/'],
  ['コンテスト', '/contests/'],
  ['更新履歴', '/updates/'],
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" href={withBase('/feed.xml', base)} />
    {studyPreview && <meta name="robots" content="noindex" />}
    <title>{title} | ABC上級問題体系化教科書</title>
  </head>
  <body
    data-pagefind-ignore={studyPreview ? 'all' : undefined}
    class:list={[
      'textbook',
      {
        'study-preview': studyPreview,
        'unit-page': unitPage,
        'problem-page':
          canonicalLogicalPath.startsWith('/problems/') && canonicalLogicalPath !== '/problems/',
      },
    ]}
  >
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <a class="site-title" href={withBase('/', base)}>ABC上級問題体系化教科書</a>
      <SearchControl base={base} />
    </header>
    <nav class="section-navigation" aria-label="主要セクション">
      <ul>
        {
          navItems.map(([label, href]) => (
            <li>
              <a href={withBase(href, base)}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div
      class:list={[
        'page-shell',
        {
          'with-sidebar': learningPage,
        },
      ]}
    >
      {
        learningPage && (
          <aside class="contents-aside" data-pagefind-ignore>
            <details id="unit-contents" class="contents-panel">
              <summary>
                章と単元の目次
                <span>
                  {navigation.chapter
                    ? `第${String(navigation.chapter.number)}章 · ${navigation.chapter.root.title}`
                    : '全9章'}
                </span>
              </summary>
              <TextbookContents currentRoute={canonicalLogicalPath} />
            </details>
          </aside>
        )
      }
      <div class="page-content">
        <nav aria-label="パンくず" class="breadcrumbs">
          <ol>
            <li><a href={withBase('/', base)}>ホーム</a></li>
            {
              pageBreadcrumbs.map((crumb) => (
                <li>
                  {crumb.href ? (
                    <a href={withBase(crumb.href, base)}>{crumb.label}</a>
                  ) : (
                    <span aria-current="page">{crumb.label}</span>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>
        <main id="main-content" data-pagefind-body={indexContent ? true : undefined}>
          {
            searchTerms.length > 0 && (
              <span
                class="visually-hidden"
                aria-hidden="true"
                data-search-projection
                data-pagefind-meta="search-terms"
              >
                {searchTerms.join(' ')}
              </span>
            )
          }
          {
            studyPreview && (
              <p class="preview-notice" data-pagefind-ignore>
                読みやすさの試作 · 代表4ページのみ。本文・情報順序の比較用です。
              </p>
            )
          }
          <slot />
        </main>
        {
          (previous ?? next) && (
            <nav class="previous-next" aria-label="前後のページ">
              {previous ? (
                <a rel="prev" href={withBase(previous.href ?? '/', base)}>
                  <span>← 前のページ</span>
                  {previous.label}
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a rel="next" href={withBase(next.href ?? '/', base)}>
                  <span>次のページ →</span>
                  {next.label}
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </div>
    </div>
    <footer>
      <p>ABCの過去問から、ARC・AGC・CF Div. 1・UCUPへ応用する典型知識を学びます。</p>
    </footer>
  </body>
</html>

<script>
  import '../client/textbook-navigation.js';
</script>
