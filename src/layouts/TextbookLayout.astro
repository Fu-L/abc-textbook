---
import SearchControl from '../components/SearchControl.astro';
import { publicCatalog, requireCatalogEntity, withBase } from '../lib/catalog/public-catalog.js';
import { buildSearchDocuments } from '../lib/catalog/search-documents.js';
import '../styles/global.css';
import { unitLearningTarget } from '../lib/taxonomy/unit-learning-targets.js';
import { TEXTBOOK_CHAPTERS } from '../lib/taxonomy/textbook-order.js';

interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Crumb[];
  previous?: Crumb | undefined;
  next?: Crumb | undefined;
}

const { title, description, breadcrumbs = [], previous, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(withBase(Astro.url.pathname.slice(base.length - 1), base), Astro.site);
const logicalPath = `/${Astro.url.pathname.slice(base.length).replace(/^\/+|\/+$/gu, '')}`;
const canonicalLogicalPath = logicalPath === '/' ? '/' : `${logicalPath}/`;
const indexContent = !['/review/', '/settings/learning-records/'].includes(canonicalLogicalPath);
const searchDocuments = buildSearchDocuments(publicCatalog).filter(
  ({ route }) => route === canonicalLogicalPath,
);
const searchTerms = [...new Set(searchDocuments.flatMap(({ terms }) => terms))];
const navItems = [
  ['学習経路', '/learn/'],
  ['問題', '/problems/'],
  ['典型タグ', '/tags/'],
  ['コンテスト', '/contests/'],
  ['更新履歴', '/updates/'],
] as const;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" href={withBase('/feed.xml', base)} />
    <title>{title} | ABC上級問題体系化教科書</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <header class="site-header">
      <a class="site-title" href={withBase('/', base)}>ABC上級問題体系化教科書</a>
      <SearchControl base={base} />
    </header>
    <nav class="section-navigation" aria-label="主要セクション">
      <ul>
        {
          navItems.map(([label, href]) => (
            <li>
              <a href={withBase(href, base)}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div
      class:list={['page-shell', { 'with-sidebar': canonicalLogicalPath.startsWith('/learn/') }]}
    >
      {
        canonicalLogicalPath.startsWith('/learn/') && (
          <nav class="textbook-sidebar" aria-label="教科書の目次" data-pagefind-ignore>
            {TEXTBOOK_CHAPTERS.map((chapter) => {
              const root = requireCatalogEntity(
                publicCatalog.learningUnits.find((unit) => unit.id === chapter.id),
                chapter.id,
              );
              return (
                <details
                  open={
                    chapter.id ===
                      publicCatalog.learningUnits.find(
                        (item) => item.route === canonicalLogicalPath,
                      )?.id ||
                    chapter.unitIds.some(
                      (id) =>
                        publicCatalog.learningUnits.find((item) => item.id === id)?.route ===
                        canonicalLogicalPath,
                    )
                  }
                >
                  <summary>{root.title}</summary>
                  <p>
                    <a href={withBase(root.route, base)}>章を読む</a>
                  </p>
                  <ol>
                    {chapter.unitIds.map((id) => {
                      const unit = requireCatalogEntity(
                        publicCatalog.learningUnits.find((item) => item.id === id),
                        id,
                      );
                      return (
                        <li>
                          <a
                            href={withBase(unit.route, base)}
                            aria-current={canonicalLogicalPath === unit.route ? 'page' : undefined}
                          >
                            {unit.title}
                          </a>{' '}
                          — {unitLearningTarget(id).color}
                        </li>
                      );
                    })}
                  </ol>
                </details>
              );
            })}
          </nav>
        )
      }
      <div class="page-content">
        <nav aria-label="パンくず" class="breadcrumbs">
          <ol>
            <li><a href={withBase('/', base)}>ホーム</a></li>
            {
              breadcrumbs.map((crumb) => (
                <li>
                  {crumb.href ? (
                    <a href={withBase(crumb.href, base)}>{crumb.label}</a>
                  ) : (
                    <span aria-current="page">{crumb.label}</span>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>
        <main id="main-content" data-pagefind-body={indexContent ? true : undefined}>
          {
            searchTerms.length > 0 && (
              <span
                class="visually-hidden"
                aria-hidden="true"
                data-search-projection
                data-pagefind-meta="search-terms"
              >
                {searchTerms.join(' ')}
              </span>
            )
          }
          <slot />
        </main>
        {
          (previous ?? next) && (
            <nav class="previous-next" aria-label="前後のページ">
              {previous ? (
                <a rel="prev" href={withBase(previous.href ?? '/', base)}>
                  ← {previous.label}
                </a>
              ) : (
                <span />
              )}
              {next ? (
                <a rel="next" href={withBase(next.href ?? '/', base)}>
                  {next.label} →
                </a>
              ) : (
                <span />
              )}
            </nav>
          )
        }
      </div>
    </div>
    <footer>
      <p>ABCの過去問から、ARC・AGC・CF Div. 1・UCUPへ応用する典型知識を学びます。</p>
    </footer>
  </body>
</html>
