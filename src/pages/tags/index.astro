---
import TextbookLayout from '../../layouts/TextbookLayout.astro';
import { previewCatalog, withBase } from '../../lib/catalog/preview-ui-catalog.js';
const base = import.meta.env.BASE_URL;
---

<TextbookLayout
  title="典型タグ"
  description="initial-v1 の典型タグ索引"
  breadcrumbs={[{ label: '典型タグ' }]}
>
  <span data-pagefind-meta="entity-kind">典型タグ索引</span>
  <h1>典型タグ</h1>
  <p>preview 用の provisional tag です。T159 の全コーパス統合までは公開正本に昇格しません。</p>
  <ul>
    {
      previewCatalog.tags.map((tag) => (
        <li>
          <>
            <h2>
              <a href={withBase(tag.route, base)}>{tag.name}</a>
            </h2>
            <p>{tag.definition}</p>
          </>
        </li>
      ))
    }
  </ul>
</TextbookLayout>
