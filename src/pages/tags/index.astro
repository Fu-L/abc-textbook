---
import TextbookLayout from '../../layouts/TextbookLayout.astro';
import { publicCatalog, withBase } from '../../lib/catalog/public-catalog.js';
const base = import.meta.env.BASE_URL;
---

<TextbookLayout
  title="典型タグ"
  description="全コーパスの典型タグ索引"
  breadcrumbs={[{ label: '典型タグ' }]}
>
  <span data-pagefind-meta="entity-kind">典型タグ索引</span>
  <h1>典型タグ</h1>
  <p>定義から使う場面を確かめ、タグ名から手掛かり・単元・問題へ進めます。</p>
  <ul class="tag-index">
    {
      publicCatalog.tags.map((tag) => (
        <li>
          <>
            <h2>
              <a href={withBase(tag.route, base)}>{tag.name}</a>
            </h2>
            <p>{tag.definition}</p>
          </>
        </li>
      ))
    }
  </ul>
</TextbookLayout>
