---
import TextbookLayout from '../../layouts/TextbookLayout.astro';
import {
  publicCatalog,
  requireCatalogEntity,
  publicProjection,
  withBase,
  type UiCatalog,
} from '../../lib/catalog/public-catalog.js';

interface Props {
  tag: UiCatalog['tags'][number];
}
export function getStaticPaths() {
  return publicCatalog.tags.map((tag) => ({ params: { slug: tag.id }, props: { tag } }));
}
const { tag } = Astro.props;
const canonicalTag = requireCatalogEntity(
  publicProjection.catalog.tags.find((item) => item.id === tag.id),
  tag.id,
);
const base = import.meta.env.BASE_URL;
const unit = publicCatalog.learningUnits.find((item) => item.ownedTagIds.includes(tag.id));
---

<TextbookLayout
  title={tag.name}
  description={tag.definition}
  breadcrumbs={[{ href: '/tags/', label: '典型タグ' }, { label: tag.name }]}
>
  <span data-pagefind-meta="entity-kind">典型タグ</span>
  <h1>{tag.name}</h1>
  <p>{tag.definition}</p>
  <p>検索別名: {tag.aliases.join('、')}</p>
  <section>
    <h2>分類と直接の前提</h2>
    {
      canonicalTag.parentId && (
        <p>
          概念上の親:{' '}
          <a href={withBase(`/tags/${canonicalTag.parentId}/`, base)}>
            {publicCatalog.tags.find((item) => item.id === canonicalTag.parentId)?.name}
          </a>
        </p>
      )
    }
    <ul>
      {
        canonicalTag.prerequisiteTagIds.map((id) => (
          <li>
            <a href={withBase(`/tags/${id}/`, base)}>
              {publicCatalog.tags.find((item) => item.id === id)?.name}
            </a>
          </li>
        ))
      }
    </ul>
    <h3>関連する典型</h3><ul>
      {
        canonicalTag.relatedTags.map((relation) => (
          <li>
            <a href={withBase(`/tags/${relation.tagId}/`, base)}>
              {publicCatalog.tags.find((item) => item.id === relation.tagId)?.name}
            </a>
            : {relation.rationale}
          </li>
        ))
      }
    </ul>
  </section>
  <section>
    <h2>学習成果と学習単位</h2>{
      unit && (
        <p>
          <a href={withBase(unit.route, base)}>{unit.title}</a>: {unit.outcome}
        </p>
      )
    }
  </section>
  <section>
    <h2>代表・関連問題</h2><ul>
      {
        tag.problemIds.map((id) => {
          const problem = publicCatalog.problems.find((item) => item.id === id);
          return (
            problem && (
              <li>
                <a href={withBase(problem.route, base)}>
                  {problem.id.toUpperCase()} — {problem.title}
                </a>
              </li>
            )
          );
        })
      }
    </ul>
  </section>
</TextbookLayout>
