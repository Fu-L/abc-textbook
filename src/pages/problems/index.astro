---
import ProblemFilters from '../../components/ProblemFilters.tsx';
import TextbookLayout from '../../layouts/TextbookLayout.astro';
import { previewCatalog } from '../../lib/catalog/preview-ui-catalog.js';
const base = import.meta.env.BASE_URL;
const tagNames = Object.fromEntries(previewCatalog.tags.map(({ id, name }) => [id, name]));
const unitTitles = Object.fromEntries(
  previewCatalog.learningUnits.map(({ id, title }) => [id, title]),
);
---

<TextbookLayout
  title="問題一覧"
  description="initial-v1 問題の複合絞り込み"
  breadcrumbs={[{ label: '問題一覧' }]}
>
  <span data-pagefind-meta="entity-kind">問題索引</span>
  <h1>問題一覧</h1>
  <p>
    表示ラベルで条件を組み合わせ、適用した静的条件を URL query に保存します。端末内の学習状態はこの
    preview catalog に含めません。
  </p>
  <noscript
    ><p>絞り込みにはJavaScriptが必要です。下の全問題一覧はそのまま利用できます。</p></noscript
  >
  <ProblemFilters client:load {base} problems={previewCatalog.problems} {tagNames} {unitTitles} />
</TextbookLayout>
