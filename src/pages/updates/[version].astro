---
import TextbookLayout from '../../layouts/TextbookLayout.astro';
import { publicProjection } from '../../lib/catalog/public-catalog.js';
import type { PublicReleaseHistoryEntry } from '../../lib/catalog/build-release-history.js';
interface Props {
  release: PublicReleaseHistoryEntry;
}
export function getStaticPaths() {
  return publicProjection.history.map((release) => ({
    params: { version: release.version },
    props: { release },
  }));
}
const { release } = Astro.props;
---

<TextbookLayout
  title={`更新 ${release.version}`}
  description={`${release.version}の収録範囲と検証結果`}
  breadcrumbs={[{ href: '/updates/', label: '更新履歴' }, { label: release.version }]}
>
  <span data-pagefind-meta="entity-kind">更新履歴</span><h1>{release.version}</h1>
  <p>
    {release.firstContestId}〜{release.lastContestId} / {release.contestCount}コンテスト・{
      release.problemCount
    }問
  </p>
  <p>基準日時: <time datetime={release.cutoffAt}>{release.cutoffAt}</time></p>
  <p>検証日時: <time datetime={release.validatedAt}>{release.validatedAt}</time></p>
  <p>Git commit: <code>{release.commit}</code></p>
  <p><a href={release.validationResultsUrl}>検証結果</a></p>
  <p><a href={new URL('../', Astro.url).pathname}>最新の配信情報と公開履歴の一覧</a></p>
  <details>
    <summary>変更・公開情報の詳細</summary><pre>{JSON.stringify(release, null, 2)}</pre>
  </details>
</TextbookLayout>

<style>
  pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
