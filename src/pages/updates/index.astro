---
import TextbookLayout from '../../layouts/TextbookLayout.astro';
import {
  publicCatalog,
  publicReleaseMetadata,
  withBase,
} from '../../lib/catalog/public-catalog.js';
const base = import.meta.env.BASE_URL;
---

<TextbookLayout
  title="更新履歴"
  description="公開版の対象範囲と変更履歴"
  breadcrumbs={[{ label: '更新履歴' }]}
>
  <span data-pagefind-meta="entity-kind">更新履歴</span><h1>更新履歴</h1>
  <h2 id="latest-deployment">最新の配信情報</h2>
  <p>
    この一覧は公開後に追記する履歴です。最新の配信は、一覧への反映前や履歴だけの更新を含め、GitHub
    Pages の公開履歴で確認できます。
  </p>
  <p>
    <a
      href="https://github.com/Fu-L/abc-textbook/deployments/activity_log?environments_filter=github-pages"
      >Pages の公開履歴</a
    >
    {' / '}<a href="https://github.com/Fu-L/abc-textbook/actions/workflows/ci.yml"
      >Actions の検証・配信結果</a
    >
  </p>
  {
    publicReleaseMetadata && (
      <p>
        この配信の版: <code>{publicReleaseMetadata.version}</code>。{' '}
        <a href={withBase('/release-metadata.json', base)}>配信 metadata</a> /{' '}
        <a href={publicReleaseMetadata.validationResultsUrl}>この版の検証・配信結果</a>
      </p>
    )
  }
  <h2 id="published-history">公開後に記録した履歴</h2>
  {
    publicCatalog.releaseHistory.length === 0 ? (
      <p>
        初版はABC212〜466の868問を収録しています。収録基準日時は2026年7月12日0時（日本時間）です。
        初版配信後の更新履歴はここに追加します。
      </p>
    ) : (
      <ul>
        {publicCatalog.releaseHistory.map((release) => (
          <li>
            <a href={withBase(release.route, base)}>{release.version}</a> — {release.problemCount}問
          </li>
        ))}
      </ul>
    )
  }
</TextbookLayout>
