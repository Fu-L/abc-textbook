---
import { isStudyPreview, previewUnit } from '../../lib/study-preview/render.js';
import TextbookLayout from '../../layouts/TextbookLayout.astro';
import {
  publicCatalog,
  publicProjection,
  type UiCatalog,
} from '../../lib/catalog/public-catalog.js';
import { renderPublicDocument } from '../../lib/catalog/render-public-document.js';
interface Props {
  unit: UiCatalog['learningUnits'][number];
}
export function getStaticPaths() {
  return publicCatalog.learningUnits.map((unit) => ({
    params: { slug: unit.route.replace(/^\/learn\//u, '').replace(/\/$/u, '') },
    props: { unit },
  }));
}
const { unit } = Astro.props;
const document = publicProjection.unitDocuments.get(unit.id);
if (!document) throw new Error(`Missing accepted Unit: ${unit.id}`);
const studyPreview = isStudyPreview(import.meta.env.STUDY_UX_PREVIEW, unit.route);
const originalBody = await renderPublicDocument(
  document.text,
  import.meta.env.BASE_URL,
  true,
  new Map(publicCatalog.problems.map((problem) => [problem.officialUrl, problem.route])),
);
const body = studyPreview
  ? await previewUnit(originalBody, unit.id, import.meta.env.BASE_URL)
  : originalBody;
---

<TextbookLayout
  studyPreview={studyPreview}
  title={unit.title}
  description={unit.outcome}
  breadcrumbs={[{ href: '/learn/', label: '分野別目次' }, { label: unit.title }]}
>
  <span hidden={studyPreview} data-pagefind-meta="entity-kind">学習単位</span>
  <h1>{unit.title}</h1>
  <div class="authored-content" set:html={body} />
</TextbookLayout>
