---
import TextbookLayout from '../../layouts/TextbookLayout.astro';
import {
  publicCatalog,
  publicProjection,
  type UiCatalog,
} from '../../lib/catalog/public-catalog.js';
import { renderPublicDocument } from '../../lib/catalog/render-public-document.js';
import { withBase } from '../../lib/catalog/ui-catalog.js';
interface Props {
  unit: UiCatalog['learningUnits'][number];
}
export function getStaticPaths() {
  return publicCatalog.learningUnits.map((unit) => ({
    params: { slug: unit.route.replace(/^\/learn\//u, '').replace(/\/$/u, '') },
    props: { unit },
  }));
}
const { unit } = Astro.props;
const document = publicProjection.unitDocuments.get(unit.id);
if (!document) throw new Error(`Missing accepted Unit: ${unit.id}`);
const body = await renderPublicDocument(
  document.text,
  import.meta.env.BASE_URL,
  true,
  new Map(publicCatalog.problems.map((problem) => [problem.officialUrl, problem.route])),
);
---

<TextbookLayout
  title={unit.title}
  description={unit.outcome}
  breadcrumbs={[{ href: '/learn/', label: '分野別目次' }, { label: unit.title }]}
>
  <span data-pagefind-meta="entity-kind">学習単位</span>
  <h1>{unit.title}</h1>
  <div class="authored-content" set:html={body} />
  {
    unit.problemIds.some((id) => Number(id.slice(3, id.indexOf('-'))) > 466) && (
      <section aria-labelledby="catch-up-problems">
        <h2 id="catch-up-problems">追加の収録問題</h2>
        <ul>
          {unit.problemIds
            .filter((id) => Number(id.slice(3, id.indexOf('-'))) > 466)
            .map((id) => {
              const problem = publicCatalog.problems.find((item) => item.id === id);
              return (
                problem && (
                  <li>
                    <a href={withBase(problem.route, import.meta.env.BASE_URL)}>
                      {problem.id.toUpperCase()} — {problem.title}
                    </a>
                  </li>
                )
              );
            })}
        </ul>
      </section>
    )
  }
</TextbookLayout>
