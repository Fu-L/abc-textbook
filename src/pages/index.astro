---
import TextbookLayout from '../layouts/TextbookLayout.astro';
import { previewCatalog, withBase } from '../lib/catalog/preview-ui-catalog.js';

const base = import.meta.env.BASE_URL;
---

<TextbookLayout title="ホーム" description="ABC上級問題を典型と前提関係から学ぶ initial-v1 preview">
  <span data-pagefind-meta="entity-kind">ホーム</span>
  <h1>ABC上級問題体系化教科書</h1>
  <p>
    <strong>initial-v1 preview</strong> は、4分野・{previewCatalog.problems.length}問を同じ catalog
    経路で検証する非公開の縦切りです。
  </p>
  <p>
    問題から逆引きする場合はコンテスト表または問題一覧を、順番に学ぶ場合は標準学習経路を使ってください。
  </p>
  <nav aria-label="ホームの入口" class="card-links">
    <ul>
      <li><a href={withBase('/learn/', base)}>標準学習経路を見る</a></li>
      <li><a href={withBase('/contests/', base)}>コンテストから逆引きする</a></li>
      <li><a href={withBase('/problems/', base)}>問題を条件で絞り込む</a></li>
      <li><a href={withBase('/updates/', base)}>preview の固定情報を確認する</a></li>
    </ul>
  </nav>
  <section aria-labelledby="preview-scope">
    <h2 id="preview-scope">preview 対象</h2>
    <p>
      ABC {previewCatalog.contests[0]?.number}〜{previewCatalog.contests.at(-1)?.number} の選定問題を含み、問題記号は
      {previewCatalog.registry.labels.join('、')} を動的に扱います。
    </p>
  </section>
</TextbookLayout>
