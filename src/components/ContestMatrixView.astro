---
import type { UiCatalog } from '../lib/catalog/public-catalog.js';
import ContestProblemCell from './ContestProblemCell.astro';

interface Props {
  base: string;
  catalog: UiCatalog;
  heading: string;
  headingId: string;
  showAlternative?: boolean;
  indexContent?: boolean;
}

const {
  base,
  catalog,
  heading,
  headingId,
  showAlternative = true,
  indexContent = false,
} = Astro.props;
const cells = new Map(catalog.cells.map((cell) => [`${cell.contestId}:${cell.label}`, cell]));
---

<section
  aria-labelledby={headingId}
  data-registry-labels={catalog.registry.labels.join(',')}
  data-pagefind-ignore={indexContent ? undefined : true}
>
  <h2 id={headingId}>{heading}</h2>
  <p>問題名から解説へ進めます。単元・タグ・類題は各問題の「学習のつながり」で確認できます。</p>
  {
    showAlternative && (
      <p>
        横に長い表は枠内でスクロールできます。縦に読む場合は
        <a href={`#${headingId}-alternative`}>コンテスト別リスト</a>へ。
      </p>
    )
  }
  <div
    class="matrix-scroll"
    data-matrix-scroll
    tabindex="0"
    aria-label={`${heading}のスクロール領域`}
  >
    <table>
      <caption>{heading} · Dより後の公式問題。記号のない回は「公式問題なし」と表示します。</caption>
      <thead>
        <tr>
          <th scope="col">コンテスト</th>
          {catalog.registry.labels.map((label) => <th scope="col">{label}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          catalog.contests.map((contest) => (
            <tr id={`${headingId}-${contest.id}`}>
              <th scope="row">
                <a
                  href={contest.officialUrl}
                  rel="external"
                  aria-label={`ABC ${String(contest.number)}（外部公式サイト）`}
                >
                  ABC {contest.number}
                </a>
              </th>
              {catalog.registry.labels.map((label) => {
                const cell = cells.get(`${contest.id}:${label}`);
                return (
                  <td>
                    {cell && <ContestProblemCell base={base} catalog={catalog} cell={cell} />}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

{
  showAlternative && (
    <section
      aria-labelledby={`${headingId}-alternative`}
      data-pagefind-ignore={indexContent ? undefined : true}
    >
      <h2 id={`${headingId}-alternative`}>コンテスト別リスト</h2>
      <details class="contest-alternative">
        <summary>表と同じ問題を縦に読む</summary>
        {catalog.contests.map((contest) => (
          <article class="contest-list-entry">
            <h3>ABC {contest.number}</h3>
            <dl>
              {catalog.registry.labels.map((label) => {
                const cell = cells.get(`${contest.id}:${label}`);
                return (
                  cell && (
                    <>
                      <dt>{label}</dt>
                      <dd>
                        <ContestProblemCell base={base} catalog={catalog} cell={cell} />
                      </dd>
                    </>
                  )
                );
              })}
            </dl>
          </article>
        ))}
      </details>
    </section>
  )
}
