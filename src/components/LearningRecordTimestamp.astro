---
interface Props {
  value: string | null;
  label: string;
}
const { value, label } = Astro.props;
const formatted = value
  ? new Intl.DateTimeFormat('ja-JP', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      timeZoneName: 'short',
    }).format(new Date(value))
  : '更新記録なし';
---

<span data-learning-record-timestamp>
  {label}: {value ? <time datetime={value}>{formatted}</time> : formatted}
</span>
