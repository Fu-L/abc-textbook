---
import { publicCatalog, withBase } from '../lib/catalog/public-catalog.js';
import { textbookNavigation } from './textbook-navigation.js';
interface Props {
  currentRoute: string;
}
const { currentRoute: canonicalLogicalPath } = Astro.props;
const base = import.meta.env.BASE_URL;
const { chapters } = textbookNavigation(publicCatalog.learningUnits, canonicalLogicalPath);
---

<nav class="textbook-sidebar" aria-label="教科書の目次" data-pagefind-ignore>
  {
    chapters.map(({ root, units, number, current }) => {
      return (
        <details class:list={['contents-chapter', { 'current-chapter': current }]} open={current}>
          <summary>
            <span>第{number}章</span> {root.title}
          </summary>
          <p>
            <a
              href={withBase(root.route, base)}
              aria-current={canonicalLogicalPath === root.route ? 'page' : undefined}
            >
              章の概要
            </a>
          </p>
          <ol>
            {units.map((unit) => {
              return (
                <li>
                  <a
                    href={withBase(unit.route, base)}
                    aria-current={canonicalLogicalPath === unit.route ? 'page' : undefined}
                  >
                    {unit.title}
                  </a>
                </li>
              );
            })}
          </ol>
        </details>
      );
    })
  }
</nav>
