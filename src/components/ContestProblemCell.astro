---
import { publicCatalog, withBase, type UiCatalog } from '../lib/catalog/public-catalog.js';

interface Props {
  base: string;
  cell: (typeof publicCatalog.cells)[number];
  catalog?: UiCatalog;
}

const { base, cell, catalog = publicCatalog } = Astro.props;
const problem = cell.problemId
  ? catalog.problems.find(({ id }) => id === cell.problemId)
  : undefined;
const unit = problem
  ? catalog.learningUnits.find(({ id }) => id === problem.learningUnitId)
  : undefined;
const unavailableMessage = {
  official_absent: 'このコンテストの公式問題一覧に該当記号はありません。',
  preview: '収録問題の情報を読み込めません。',
  published: '収録問題の情報を読み込めません。',
  unknown: '公式問題の状態を確認できません。',
  withdrawn: '公式サイトで取り下げられています。',
  unpublished: '公式問題はありますが、まだ未収録です。',
} as const;
---

<div class:list={['contest-cell', `state-${cell.state}`]} data-problem-id={problem?.id}>
  <span class="contest-state">{cell.stateLabel}</span>
  {
    problem ? (
      <>
        <a
          class="contest-problem-title"
          href={withBase(problem.route, base)}
          aria-label={`${problem.id.toUpperCase()} — ${problem.title}`}
        >
          {problem.title}
        </a>
        <details class="contest-cell-context">
          <summary aria-label={`${problem.id.toUpperCase()}の学習のつながり`}>
            学習のつながり
          </summary>
          <div class="cell-links">
            <p>
              <a href={`${withBase(problem.route, base)}${problem.explanationAnchor}`}>
                解説の本文へ
              </a>
            </p>
            {unit && (
              <p>
                単元: <a href={withBase(unit.route, base)}>{unit.title}</a>
              </p>
            )}
            {(
              [
                ['主タグ', problem.primaryTagIds],
                ['補助タグ', problem.supportingTagIds],
              ] as const
            ).map(
              ([label, ids]) =>
                ids.length > 0 && (
                  <p>
                    {label}:{' '}
                    {ids.map((tagId, index) => {
                      const tag = catalog.tags.find(({ id }) => id === tagId);
                      return (
                        tag && (
                          <>
                            {index > 0 ? '、' : ''}
                            <a
                              href={withBase(tag.route, base)}
                              aria-label={`${label}: ${tag.name}`}
                            >
                              {tag.name}
                            </a>
                          </>
                        )
                      );
                    })}
                  </p>
                ),
            )}
            {problem.similarProblemIds.length > 0 && (
              <p>
                類題:{' '}
                {problem.similarProblemIds.map((problemId, index) => {
                  const similar = catalog.problems.find(({ id }) => id === problemId);
                  return (
                    similar && (
                      <>
                        {index > 0 ? '、' : ''}
                        <a href={withBase(similar.route, base)}>{similar.id.toUpperCase()}</a>
                      </>
                    )
                  );
                })}
              </p>
            )}
          </div>
        </details>
      </>
    ) : (
      <span
        class:list={{ 'visually-hidden': cell.state === 'official_absent' }}
        data-pagefind-ignore
      >
        {unavailableMessage[cell.state]}
      </span>
    )
  }
</div>
