---
import {
  previewCatalog,
  withBase,
  type PreviewUiCatalog,
} from '../lib/catalog/preview-ui-catalog.js';

interface Props {
  base: string;
  cell: (typeof previewCatalog.cells)[number];
  catalog?: PreviewUiCatalog;
}

const { base, cell, catalog = previewCatalog } = Astro.props;
const problem = cell.problemId
  ? catalog.problems.find(({ id }) => id === cell.problemId)
  : undefined;
const tag = problem ? catalog.tags.find(({ id }) => id === problem.primaryTagId) : undefined;
const unit = problem
  ? catalog.learningUnits.find(({ id }) => id === problem.learningUnitId)
  : undefined;
const unavailableMessage = {
  official_absent: 'このコンテストの公式問題一覧に該当記号はありません。',
  preview: '収録問題の情報を読み込めません。',
  unknown: '公式問題の状態を確認できません。',
  withdrawn: '公式サイトで取り下げられています。',
  unpublished: '公式問題はありますが、この preview には未収録です。',
} as const;
---

<div class:list={['contest-cell', `state-${cell.state}`]} data-problem-id={problem?.id}>
  <strong>{cell.stateLabel}</strong>
  {
    problem ? (
      <>
        <span>
          {problem.id.toUpperCase()} — {problem.title}
        </span>
        <ul class="cell-links">
          <li>
            <a href={withBase(problem.route, base)}>問題詳細: {problem.id}</a>
          </li>
          <li>
            <a href={`${withBase(problem.route, base)}${problem.explanationAnchor}`}>
              解説: {problem.title}
            </a>
          </li>
          {unit && (
            <li>
              <a href={withBase(unit.route, base)}>学習単位: {unit.title}</a>
            </li>
          )}
          {tag && (
            <li>
              <a href={withBase(tag.route, base)}>主タグ: {tag.name}</a>
            </li>
          )}
          {problem.supportingTagIds.map((tagId) => {
            const supporting = catalog.tags.find(({ id }) => id === tagId);
            return (
              supporting && (
                <li>
                  <a href={withBase(supporting.route, base)}>補助タグ: {supporting.name}</a>
                </li>
              )
            );
          })}
          {problem.similarProblemIds.map((problemId) => {
            const similar = catalog.problems.find(({ id }) => id === problemId);
            return (
              similar && (
                <li>
                  <a href={withBase(similar.route, base)}>類題: {similar.id}</a>
                </li>
              )
            );
          })}
        </ul>
      </>
    ) : (
      <span data-pagefind-ignore>{unavailableMessage[cell.state]}</span>
    )
  }
</div>
