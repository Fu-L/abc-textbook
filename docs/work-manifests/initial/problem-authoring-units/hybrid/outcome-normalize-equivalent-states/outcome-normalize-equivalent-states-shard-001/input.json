    {
      "problemId": "abc302-g",
      "learningOutcomeIds": [
        "outcome-normalize-equivalent-states"
      ],
      "baseline": {
        "id": "prereq-abc-advanced-v1",
        "version": "1.0.0"
      },
      "additionalPrerequisiteUnitIds": [
        "unit-bounded-enumeration"
      ],
      "excludedTopics": [
        "交換論による貪欲順の証明。"
      ],
      "tagIds": [
        "tag-state-normalization",
