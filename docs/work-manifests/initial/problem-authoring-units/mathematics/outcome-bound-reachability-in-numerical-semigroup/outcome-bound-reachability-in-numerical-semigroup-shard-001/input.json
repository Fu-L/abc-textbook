      "constraints": [
        "Time limit: 4 sec; Memory limit: 1024 MiB; Constraints: 2 \\leq N \\leq 10^{12}; 0 \\leq M \\leq 2 \\times 10^4; 1 \\leq A \\leq B \\leq 20; 1 < L_i \\leq R_i < N \\ (1 \\leq i \\leq M); R_i < L_{i+1} \\ (1 \\leq i \\leq M - 1); All input values are integers."
      ],
      "placementCandidate": {
