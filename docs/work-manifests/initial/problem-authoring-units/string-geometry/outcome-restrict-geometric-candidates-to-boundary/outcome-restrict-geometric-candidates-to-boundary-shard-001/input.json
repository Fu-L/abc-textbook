      "constraints": [
        "Time limit: 2 sec; Memory limit: 1024 MiB; Constraints: All input values are integers.; 1 \\le N \\le 2 \\times 10^5; 1 \\le A_i, B_i \\le 10^9; 1 \\le Q \\le 2 \\times 10^5; 1 \\le C_i, D_i \\le 10^9"
      ],
      "placementCandidate": {
